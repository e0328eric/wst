//! wst: a small native Windows terminal, with its terminal model in Glosso.
P :: #import "platform.glo";
N :: #import "native.glo";
Presentation :: #import "gui_presentation.glo";
T :: #import "terminal.glo";
C :: #import "config.glo";
Colors :: #import "colors.glo";
L :: #import "layout.glo";
I :: #import "input.glo";
V :: #import "controls.glo";
S :: #import "scrollbar.glo";
K :: #import "keybindings.glo";
W :: #import "config_watch.glo";
R :: #import "config_reload.glo";
M :: #import "workspace.glo";
U :: #import "sessions.glo";
H :: #import "launch.glo";
Config_Paths :: #import "config_paths.glo";
Chrome :: #import "chrome.glo";
#import "Io";
#import "Format";
#import "Strings/Utf8";
#import "Context";
#import "Memory/Object";

#comptime {
    #if OUT.os != .Windows || OUT.cpu != .X86_64 || OUT.abi != .Msvc {
        #compile_error "wst requires the Windows x64 MSVC target";
    }
}

Selection :: U.Selection;
Divider_Drag :: struct {
    active: bool;
    node: s32 = -1;
    axis: s32;
    grab: s32;
    pending: bool;
}
Tab_Drag :: struct {
    index: s32 = -1;
    start: N.Point;
    moving: bool;
}
App_Window :: struct {
    surface: P.Window_Context;
    hwnd: usize;
    cfg: C.Config;
    config_watch: W.Watch;
    reload_state: R.State;
    workspace: M.Workspace;
    book: U.Book;
    layout: L.Layout;
    width: s32;
    height: s32;
    dpi: s32 = 96;
    cw: s32;
    ch: s32;
    base_font_size: s32;
    chrome: Chrome.State;
    divider_drag: Divider_Drag;
    tab_drag: Tab_Drag;
    notice_click: bool;
    dirty: bool = true;
    failed: bool;
    previous_title: str;
    last_blink: u64;
    output_cursor: s32;
    next_graphics_retry: u64;
    reload_notice_storage: [4096]u8;
    reload_notice_count: ssize;
    reload_notice_error: bool;
    discrete_gpu: bool;
}
initial_window: App_Window;
active_window: *App_Window;
windows: [..]*App_Window;
drop_window: ?*App_Window;
// Keep the clipboard buffer off Windows' default one-megabyte thread stack.
clipboard_storage: [1048576]u8;
render_cells: [512 * 256]P.Render_Cell;
output_buffer: [4096]u8;
performance_frequency: s64;
clock_library :: #library,system "kernel32";
clock_counter :: (value: *s64) -> s32 #foreign clock_library "QueryPerformanceCounter";
clock_frequency :: (value: *s64) -> s32 #foreign clock_library "QueryPerformanceFrequency";
clamp :: (n: s32, low: s32, high: s32) -> s32 {
    if n < low  return low;
    if n > high return high;
    return n;
}
send :: (text: str) {
    if text.count > 0 && P.pty_send(text.data, cast(s32) text.count) == 0
        print("wst: input queue full or shell unavailable\n");
}
selected :: (s: *Selection, index: s32) -> bool {
    if !s.active        return false;
    if s.start <= s.end return index >= s.start && index <= s.end;
    return index >= s.end && index <= s.start;
}
point_index :: (t: *T.Terminal, layout: L.Layout, cw: s32, ch: s32, x: s32, y: s32) -> s32 {
    cx := clamp((x - cast(s32) layout.viewport_x) / cw, 0, t.cols - 1);
    cy := clamp((y - cast(s32) layout.viewport_y) / ch, 0, t.rows - 1);
    return cy * t.cols + cx;
}
scrollbar_geometry :: (t: *const T.Terminal, layout: L.Layout) -> S.Scrollbar {
    history := t.history_count;
    if t.alternate history = 0;
    return S.compute(
        cast(s32) layout.scrollbar_x,
        cast(s32) layout.scrollbar_y,
        cast(s32) layout.scrollbar_width,
        cast(s32) layout.scrollbar_height,
        t.rows,
        history,
        t.view_offset
    );
}
zoom_action_at :: (layout: L.Layout, x: s32, y: s32) -> s32 {
    g := Chrome.geometry(
        cast(s32) layout.header_width,
        cast(s32) layout.header_height,
        P.dpi(),
        1,
        0
    );
    h := Chrome.hit(&g, x, y);
    if h.kind == Chrome.Zoom_Out   return -1;
    if h.kind == Chrome.Reset_Zoom return 2;
    if h.kind == Chrome.Zoom_In    return 1;
    return 0;
}
set_zoom :: (cfg: *C.Config, size: s32) {
    next := clamp(size, 8, 72);
    if next == cfg.font_size return;
    if P.set_font_size(next) != 0 cfg.font_size = next;
    else                          P.error_dialog(P.error());
}
install_keybindings :: (cfg: *C.Config) -> bool {
    return P.set_keybindings(
        cast([*]const P.Key_Binding) &cfg.keybindings.items,
        cfg.keybindings.count
    ) != 0;
}
reload_notice :: () -> str {
    return string_from_raw_parts(cast([*]const u8) &active_window.reload_notice_storage, active_window.reload_notice_count);
}
set_reload_notice :: (message: str, failed: bool) {
    active_window.reload_notice_count = message.count;
    if active_window.reload_notice_count > 4095 active_window.reload_notice_count = 4095;
    for i: 0..active_window.reload_notice_count active_window.reload_notice_storage[i] = message[i];
    active_window.reload_notice_error = failed;
}
notice_hit :: (layout: L.Layout, x: s32, y: s32) -> bool {
    g := Chrome.geometry(
        cast(s32) layout.header_width,
        cast(s32) layout.header_height,
        P.dpi(),
        1,
        0
    );
    return active_window.reload_notice_error && active_window.reload_notice_count > 0 && Chrome.contains(g.reset_zoom, x, y);
}
utf8_append :: (bytes: *[..]u8, cp: u32) {
    if cp < 128 bytes.push(cast(u8) cp);
    else if cp < 2048 {
        bytes.push(cast(u8)(192 | (cp >> 6)), cast(u8)(128 | (cp & 63)));
    } else if cp < 65536 {
        bytes.push(
            cast(u8)(224 | (cp >> 12)),
            cast(u8)(128 | ((cp >> 6) & 63)),
            cast(u8)(128 | (cp & 63))
        );
    } else {
        bytes.push(
            cast(u8)(240 | (cp >> 18)),
            cast(u8)(128 | ((cp >> 12) & 63)),
            cast(u8)(128 | ((cp >> 6) & 63)),
            cast(u8)(128 | (cp & 63))
        );
    }
}
copy_selection :: (t: *T.Terminal, s: *Selection) {
    if !s.active return;
    first := s.start;
    last := s.end;
    if first > last {
        first = s.end;
        last = s.start;
    }
    if first % t.cols > 0 && (T.visible_cell(t, first % t.cols, first / t.cols).flags & 16) != 0
        first -= 1;
    bytes: [..]u8;
    defer bytes.free();
    row := first / t.cols;
    while row <= last / t.cols {
        left: s32 = 0;
        right := t.cols - 1;
        if row == first / t.cols left = first % t.cols;
        if row == last / t.cols  right = last % t.cols;
        while right >= left && T.visible_cell(t, right, row).codepoint == 32 right -= 1;
        col := left;
        while col <= right {
            c := T.visible_cell(t, col, row);
            if (c.flags & 16) == 0 {
                utf8_append(&bytes, c.codepoint);
                if (c.flags & T.CELL_EMOJI_STYLE) != 0 utf8_append(&bytes, 16#fe0f);
                if (c.flags & T.CELL_TEXT_STYLE) != 0 utf8_append(&bytes, 16#fe0e);
            }
            col += 1;
        }
        if row < last / t.cols bytes.push(13, 10);
        row += 1;
    }
    if bytes.count > 0 P.clipboard_set(bytes.data, cast(s32) bytes.count);
}
paste_clipboard :: (t: *T.Terminal, s: *Selection, exited: bool) -> bool {
    if exited return false;
    count := P.clipboard_get(cast([*]u8) &clipboard_storage, 1048576);
    if count <= 0 return false;
    send(
        I.paste(
            string_from_raw_parts(cast([*]const u8) &clipboard_storage, count),
            t.bracketed_paste
        )
    );
    changed := t.view_offset != 0 || s.active;
    t.view_offset = 0;
    s.active = false;
    s.dragging = false;
    return changed;
}

help :: () {
    print("wst: Windows terminal written in Glosso\n");
    print("Usage: wst [--shell powershell|cmd|nushell] [--config PATH]\n");
    print(
        "              [--profile ID] [--command COMMAND] [--hold] [--discrete-gpu] [--smoke-test [--capture BMP]] [--help]\n"
    );
    print("Configuration: ./config.lua, then %APPDATA%/wst/config.lua.\n");
    P.help_dialog(
        "wst: Glosso Windows terminal\n\n--shell powershell|cmd|nushell\n--profile ID\n--config PATH\n--command COMMAND\n--hold\n--discrete-gpu (prefer the high-performance GPU)\n--smoke-test [--capture BMP]\n\nConfiguration: .\\config.lua, then\n%APPDATA%\\wst\\config.lua"
    );
}

smoke_test :: (cfg: *C.Config, capture_path: str, discrete_gpu: bool) {
    #assert P.open(
        cfg.font_family.c_string(),
        cfg.font_size,
        80,
        24,
        cfg.padding,
        1,
        cfg.window_opacity,
        discrete_gpu
    ) != 0;
    defer P.close();
    print("wst D3D11 adapter: {}\n", Presentation.adapter_name().to_string());
    #assert install_keybindings(cfg), "install Lua keyboard shortcuts";
    P.set_colors(cfg.selection_fg, cfg.selection_bg, cfg.cursor_text);
    P.set_ligatures(cfg.font_ligatures);
    t: T.Terminal;
    T.init(&t, 80, 24, 100, cfg.foreground, cfg.background);
    defer T.release(&t);
    #assert P.pty_start("cmd.exe /d /q /c echo GLOSSO_ST_WIN_OK", 80, 24) != 0;
    #assert P.pty_resize(90, 26) != 0;
    T.resize(&t, 90, 26);
    buffer: [65536]u8;
    output: [..]u8;
    defer output.free();
    start := P.ticks();
    found := false;
    exited := false;
    code: s32;
    while P.ticks() - start < 10000 {
        n := P.pty_read(cast([*]u8) &buffer, 65536);
        if n > 0 {
            T.feed(&t, string_from_raw_parts(cast([*]const u8) &buffer, n));
            for i: 0..n output.push(buffer[i]);
            text := cast(str) output.view();
            for i: 0..text.count if i + 16 <= text.count && text[i..i + 16] == "GLOSSO_ST_WIN_OK" found = true;
        }
        if t.replies.count > 0 {
            send(cast(str) t.replies.view());
            t.replies.clear();
        }
        exited = P.pty_status(&code) == 1;
        if found && exited break;
        P.wait(10);
    }
    #assert found && exited && code == 0, "end-to-end shell output";
    width, height, cw, ch: s32;
    P.metrics(&width, &height, &cw, &ch);
    layout := L.compute(width, height, cfg.padding, cast(f32) P.dpi() / 96.0);
    T.resize(
        &t,
        clamp(cast(s32) layout.viewport_width / cw, 2, 512),
        clamp(cast(s32) layout.viewport_height / ch, 1, 256)
    );
    for i: 0..t.rows + 40 T.feed(&t, tprint("Scrollback example line {}\r\n", i + 1));
    T.scroll_view(&t, 12);
    history_before := t.history_count;
    original_size := cfg.font_size;
    trial_size := clamp(original_size + 4, 8, 72);
    if trial_size == original_size trial_size = original_size - 4;
    #assert P.set_font_size(trial_size) != 0, "zoom in the assembled application";
    P.metrics(&width, &height, &cw, &ch);
    layout = L.compute(width, height, cfg.padding, cast(f32) P.dpi() / 96.0);
    T.resize(
        &t,
        clamp(cast(s32) layout.viewport_width / cw, 2, 512),
        clamp(cast(s32) layout.viewport_height / ch, 1, 256)
    );
    #assert t.history_count == history_before && t.view_offset == 12, "zoom preserves scrollback and position";
    #assert P.set_font_size(original_size) != 0, "reset application zoom";
    P.metrics(&width, &height, &cw, &ch);
    layout = L.compute(width, height, cfg.padding, cast(f32) P.dpi() / 96.0);
    T.resize(
        &t,
        clamp(cast(s32) layout.viewport_width / cw, 2, 512),
        clamp(cast(s32) layout.viewport_height / ch, 1, 256)
    );
    t.view_offset = 0;
    T.feed(&t, "\x1b[2J\x1b[HGlosso terminal\r\n\r\n");
    T.feed(&t, "\x1b[1;38;2;129;161;193mNative Windows  /  ConPTY  /  Clay\x1b[0m\r\n\r\n");
    T.feed(
        &t,
        "PowerShell, Command Prompt and Nushell\r\nLua configuration  |  UTF-8  |  Scrollback\r\n\r\n"
    );
    T.feed(&t, "Unicode: 한글  日本語  😀\r\n\r\n");
    T.feed(
        &t,
        "\x1b[31mred  \x1b[32mgreen  \x1b[33myellow  \x1b[34mblue  \x1b[35mmagenta  \x1b[36mcyan\x1b[0m\r\n\r\n"
    );
    T.feed(
        &t,
        "\x1b[48;2;45;58;78m  true color background  \x1b[0m  \x1b[4munderline\x1b[0m\r\n\r\nC:\\> "
    );
    workspace_smoke(&t, cfg, layout, cw, ch, capture_path);
    print("wst smoke test passed: tabs, nested panes, Clay, ConPTY, VT, Unicode renderer.\n");
}

refresh_layout :: (
    book: *U.Book,
    workspace: *M.Workspace,
    cfg: *C.Config,
    layout: *L.Layout,
    width: *s32,
    height: *s32,
    cw: *s32,
    ch: *s32
) {
    _ := cancel_divider();
    P.metrics(width, height, cw, ch);
    active_window.dpi = P.dpi();
    if width.* > 0 && height.* > 0 {
        layout.* = L.compute(width.*, height.*, cfg.padding, cast(f32) active_window.dpi / 96.0);
        if !U.resize(book, workspace, layout.*, cw.*, ch.*)
            set_reload_notice(tprint("Could not resize a pane: {}", P.error().to_string()), true);
        publish_dividers(workspace, layout.*);
    }
}

publish_dividers :: (workspace: *const M.Workspace, base: L.Layout) {
    regions: [31]P.Divider_Hit;
    count: s32;
    for node: 0..63 {
        divider := M.divider_geometry(
            workspace,
            cast(s32) node,
            U.body_rect(base),
            6 * P.dpi() / 96
        );
        if divider.node >= 0 && divider.rect.width > 0 && divider.rect.height > 0 {
            rect := divider.rect;
            regions[count] = .{ rect.x, rect.y, rect.width, rect.height, divider.axis };
            count += 1;
        }
    }
    _ := P.set_dividers(cast([*]const P.Divider_Hit) &regions, count);
}

cancel_divider :: () -> bool {
    if !active_window.divider_drag.active return false;
    active_window.divider_drag.active = false;
    active_window.divider_drag.node = -1;
    P.cancel_pointer();
    P.invalidate_frame();
    return true;
}

move_divider :: (workspace: *M.Workspace, base: L.Layout, cw: s32, ch: s32, x: s32, y: s32) {
    position := x;
    if active_window.divider_drag.axis == M.Axis_Horizontal position = y;
    if M.drag_divider(
        workspace,
        active_window.divider_drag.node,
        U.body_rect(base),
        6 * P.dpi() / 96,
        position - active_window.divider_drag.grab,
        2 * cw + 12 * P.dpi() / 96,
        ch
    )
        active_window.divider_drag.pending = true;
}

apply_divider :: (book: *U.Book, workspace: *M.Workspace, base: L.Layout, cw: s32, ch: s32) {
    if !active_window.divider_drag.pending return;
    active_window.divider_drag.pending = false;
    if !U.resize(book, workspace, base, cw, ch)
        set_reload_notice(tprint("Could not resize a pane: {}", P.error().to_string()), true);
    publish_dividers(workspace, base);
    P.invalidate_frame();
}

open_surface :: (
    book: *U.Book,
    workspace: *M.Workspace,
    cfg: *C.Config,
    base: L.Layout,
    cw: s32,
    ch: s32,
    axis: s32,
    profile_target: s32 = 0
) -> bool {
    id := U.free_id(book);
    if id == 0 {
        set_reload_notice("The window supports up to 32 panes", true);
        return false;
    }
    next := workspace.*;
    added := false;
    if axis == 0 added = M.new_tab(&next, id);
    else         added = M.split(&next, id, axis);
    if !added {
        set_reload_notice("The window supports up to 16 tabs", true);
        return false;
    }
    rects: [32]M.Rect;
    U.geometry(&next, base, &rects);
    // Reject splits that cannot display even the terminal's minimum grid.
    for i: 0..32 if M.pane_tab(&next, cast(s32) i + 1) == next.active {
        test := U.pane_layout(base, rects[i]);
        if cast(s32) test.viewport_width < 2 * cw || cast(s32) test.viewport_height < ch {
            set_reload_notice("This pane is too small to split further", true);
            return false;
        }
    }
    layout := U.pane_layout(base, rects[id - 1]);
    profile_id := cfg.default_profile;
    if profile_target > 0 {
        if profile_target > cfg.profile_count {
            set_reload_notice("The selected profile is unavailable", true);
            return false;
        }
        profile_id = cfg.profiles[profile_target - 1].id;
    } else if axis != 0 && M.focused(workspace) > 0
        profile_id = book.panes[M.focused(workspace) - 1].launch.profile_id;
    launch: H.Launch;
    defer H.release(&launch);
    if !H.resolve(cfg, profile_id, &launch) {
        set_reload_notice(tprint("Unknown profile: {}", profile_id), true);
        return false;
    }
    if !U.open_launch(book, id, cfg, &launch, U.columns(layout, cw), U.rows(layout, ch)) {
        set_reload_notice(tprint("Could not open a shell: {}", P.error().to_string()), true);
        return false;
    }
    workspace.* = next;
    _ := U.resize(book, workspace, base, cw, ch);
    publish_dividers(workspace, base);
    U.end_drag(book);
    P.invalidate_frame();
    return true;
}

close_tab :: (book: *U.Book, workspace: *M.Workspace, index: s32, base: L.Layout) {
    _ := cancel_divider();
    ids: [32]s32;
    count := M.pane_order(workspace, index, &ids);
    if !M.close_tab(workspace, index) return;
    for i: 0..count U.close(book, ids[i]);
    publish_dividers(workspace, base);
    U.end_drag(book);
    P.invalidate_frame();
}

close_pane :: (book: *U.Book, workspace: *M.Workspace, id: s32, base: L.Layout, cw: s32, ch: s32) {
    _ := cancel_divider();
    if !M.close_pane(workspace, id) return;
    U.close(book, id);
    _ := U.resize(book, workspace, base, cw, ch);
    publish_dividers(workspace, base);
    U.end_drag(book);
    P.invalidate_frame();
}

workspace_action :: (
    action: K.Action,
    book: *U.Book,
    workspace: *M.Workspace,
    cfg: *C.Config,
    base: L.Layout,
    cw: s32,
    ch: s32,
    profile_target: s32
) {
    _ := cancel_divider();
    if action == .New_Tab
        _ := open_surface(book, workspace, cfg, base, cw, ch, 0, profile_target);
    else if action == .Close_Tab
        close_tab(book, workspace, workspace.active, base);
    else if action == .Split_Horizontal
        _ := open_surface(book, workspace, cfg, base, cw, ch, M.Axis_Horizontal, profile_target);
    else if action == .Split_Vertical
        _ := open_surface(book, workspace, cfg, base, cw, ch, M.Axis_Vertical, profile_target);
    else if action == .Close_Pane
        close_pane(book, workspace, M.focused(workspace), base, cw, ch);
    else if action == .Next_Tab
        _ := M.cycle_tab(workspace, 1);
    else if action == .Previous_Tab
        _ := M.cycle_tab(workspace, -1);
    else if action == .Next_Pane
        _ := M.cycle_pane(workspace, 1);
    else if action == .Previous_Pane
        _ := M.cycle_pane(workspace, -1);
    else if action == .Focus_Pane_Left
        _ := M.focus_direction(workspace, &book.rects, -1, 0);
    else if action == .Focus_Pane_Right
        _ := M.focus_direction(workspace, &book.rects, 1, 0);
    else if action == .Focus_Pane_Up
        _ := M.focus_direction(workspace, &book.rects, 0, -1);
    else if action == .Focus_Pane_Down
        _ := M.focus_direction(workspace, &book.rects, 0, 1);
    publish_dividers(workspace, base);
    U.end_drag(book);
    P.invalidate_frame();
}

menu_action :: (
    row: s32,
    book: *U.Book,
    workspace: *M.Workspace,
    cfg: *C.Config,
    base: *L.Layout,
    cw: *s32,
    ch: *s32,
    width: *s32,
    height: *s32,
    base_size: s32
) {
    active_window.chrome.menu_open = false;
    U.end_drag(book);
    if row == 0 _ := open_surface(book, workspace, cfg, base.*, cw.*, ch.*, 0);
    else if row <= cfg.profile_count _ := open_surface(
        book,
        workspace,
        cfg,
        base.*,
        cw.*,
        ch.*,
        0,
        Chrome.profile_at(cfg, row - 1) + 1
    );
    else if row == cfg.profile_count + 1 workspace_action(
        .Split_Vertical,
        book,
        workspace,
        cfg,
        base.*,
        cw.*,
        ch.*,
        0
    );
    else if row == cfg.profile_count + 2 workspace_action(
        .Split_Horizontal,
        book,
        workspace,
        cfg,
        base.*,
        cw.*,
        ch.*,
        0
    );
    else if row == cfg.profile_count + 3 close_tab(book, workspace, workspace.active, base.*);
    else {
        zoom: s32 = 1;
        if row == cfg.profile_count + 4 zoom = -1;
        if row == cfg.profile_count + 5 zoom = 2;
        set_zoom(cfg, V.font_size(cfg.font_size, base_size, zoom));
        refresh_layout(book, workspace, cfg, base, width, height, cw, ch);
    }
    P.invalidate_frame();
}

hover_signature :: (
    book: *const U.Book,
    workspace: *const M.Workspace,
    base: L.Layout,
    height: s32,
    profiles: s32,
    x: s32,
    y: s32
) -> s32 {
    header := Chrome.geometry(
        cast(s32) base.header_width,
        cast(s32) base.header_height,
        P.dpi(),
        workspace.count,
        workspace.active
    );
    h := Chrome.hit(&header, x, y);
    if h.kind != 0 && h.kind != Chrome.Drag return h.kind * 32 + h.index + 1;
    if active_window.chrome.menu_open {
        row := Chrome.menu_hit(&header, &active_window.chrome, height, profiles + 7, x, y);
        if row >= 0                                                               return 1000 + row;
        if Chrome.contains(Chrome.menu_rect(&header, height, profiles + 7), x, y) return 1100;
    }
    divider := M.divider_at(workspace, U.body_rect(base), 6 * P.dpi() / 96, x, y);
    if divider.node >= 0 return 2000 + divider.node;
    for i: 0..32 if book.panes[i].used && M.pane_tab(workspace, cast(s32) i + 1) == workspace.active {
        bar := scrollbar_geometry(&book.panes[i].terminal, book.panes[i].layout);
        if x >= bar.x && x < bar.x + bar.width && y >= bar.y && y < bar.y + bar.height
            return 3000 + cast(s32) i;
    }
    return 0;
}

draw_terminal :: (p: *U.Pane, id: s32, cfg: *C.Config, cw: s32, ch: s32, focused: bool) {
    t := &p.terminal;
    s := &p.selection;
    layout := p.layout;
    for yi: 0..t.rows {
        y := cast(s32) yi;
        for xi: 0..t.cols {
            x := cast(s32) xi;
            c := T.visible_cell(t, x, y);
            is_selected := selected(s, y * t.cols + x);
            if (c.flags & 8) != 0 && selected(s, y * t.cols + x + 1) is_selected = true;
            flags := c.flags;
            if is_selected flags |= 16#80000000;
            render_cells[y * t.cols + x] = .{
                c.codepoint,
                c.fg,
                c.bg,
                flags,
                Colors.resolve_underline(&t.palette, c.underline_color)
            };
        }
    }
    show_cursor: s32;
    if focused && t.cursor_visible && t.view_offset == 0 && !p.exited &&
       (P.focus() == 0 || (P.ticks() / 550) % 2 == 0)
        show_cursor = 1;
    _ := P.grid_context(id);
    P.grid_clipped(
        cast(s32) layout.viewport_x,
        cast(s32) layout.viewport_y,
        t.cols,
        t.rows,
        cw,
        ch,
        cast([*]const P.Render_Cell) &render_cells,
        t.cursor_x,
        t.cursor_y,
        show_cursor,
        cfg.cursor,
        cast(s32) layout.viewport_width,
        cast(s32) layout.viewport_height,
        &t.graphics,
        t.view_offset
    );
    bar := scrollbar_geometry(t, layout);
    P.rect(bar.x, bar.y, bar.width, bar.height, cfg.background);
    if t.history_count > 0 && !t.alternate {
        thumb_width := clamp(3 * P.dpi() / 96, 2, bar.width);
        color := Chrome.mix(cfg.background, cfg.foreground, 25);
        if t.view_offset > 0 color = Chrome.mix(cfg.background, cfg.accent, 65);
        if active_window.chrome.x >= bar.x && active_window.chrome.x < bar.x + bar.width && active_window.chrome.y >= bar.y && active_window.chrome.y < bar.y + bar.height {
            thumb_width = clamp(5 * P.dpi() / 96, 2, bar.width);
            color = cfg.accent;
        }
        P.rounded_rect(
            bar.x + (bar.width - thumb_width) / 2,
            bar.thumb_y,
            thumb_width,
            bar.thumb_height,
            thumb_width / 2,
            color
        );
    }
}

render_workspace :: (
    book: *U.Book,
    workspace: *M.Workspace,
    cfg: *C.Config,
    base: L.Layout,
    cw: s32,
    ch: s32,
    base_size: s32
) {
    P.frame_begin(cfg.background);
    unit := P.dpi();
    header := Chrome.geometry(
        cast(s32) base.header_width,
        cast(s32) base.header_height,
        unit,
        workspace.count,
        workspace.active
    );
    Chrome.draw_header(
        &header,
        &active_window.chrome,
        book,
        workspace,
        cfg,
        base_size,
        active_window.reload_notice_error && active_window.reload_notice_count > 0
    );
    focused := M.focused(workspace);
    ids: [32]s32;
    visible := M.pane_order(workspace, workspace.active, &ids);
    for i: 0..32 if book.panes[i].used && M.pane_tab(workspace, cast(s32) i + 1) == workspace.active {
        rect := book.rects[i];
        id := cast(s32) i + 1;
        draw_terminal(&book.panes[i], id, cfg, cw, ch, id == focused);
        if cast(s32) i + 1 == focused && visible > 1
            P.rounded_rect(
                rect.x,
                rect.y - clamp(2 * unit / 96, 1, 4),
                24 * unit / 96,
                clamp(unit / 96, 1, 3),
                clamp(unit / 96, 1, 3),
                cfg.accent
            );
    }
    for node: 0..63 {
        divider := M.divider_geometry(workspace, cast(s32) node, U.body_rect(base), 6 * unit / 96);
        if divider.node >= 0 {
            rect := divider.rect;
            hot := Chrome.contains(.{ rect.x, rect.y, rect.width, rect.height }, active_window.chrome.x, active_window.chrome.y) || (
                active_window.divider_drag.active && active_window.divider_drag.node == cast(s32) node
            );
            ink := Chrome.mix(cfg.background, cfg.foreground, 16);
            if hot ink = cfg.accent;
            stroke := clamp(unit / 96, 1, 3);
            if divider.axis == M.Axis_Vertical
                P.rect(rect.x + (rect.width - stroke) / 2, rect.y, stroke, rect.height, ink);
            else
                P.rect(rect.x, rect.y + (rect.height - stroke) / 2, rect.width, stroke, ink);
        }
    }
    Chrome.draw_menu(
        &header,
        &active_window.chrome,
        cfg,
        cast(s32)(base.viewport_y + base.viewport_height) + cfg.padding * unit / 96,
        active_window.reload_notice_error && active_window.reload_notice_count > 0
    );
    P.frame_end();
}

workspace_smoke :: (
    terminal: *T.Terminal,
    cfg: *C.Config,
    base: L.Layout,
    cw: s32,
    ch: s32,
    capture_path: str
) {
    book: U.Book;
    defer U.release(&book);
    workspace: M.Workspace;
    #assert M.new_tab(&workspace, 1);
    #assert M.split(&workspace, 2, M.Axis_Vertical);
    #assert M.split(&workspace, 3, M.Axis_Horizontal);
    #assert M.new_tab(&workspace, 4);
    #assert M.activate(&workspace, 0);
    bounds := U.body_rect(base);
    gap := 6 * P.dpi() / 96;
    root := workspace.tabs[0].root;
    #assert M.drag_divider(
        &workspace,
        root,
        bounds,
        gap,
        bounds.x + bounds.width * 3 / 5,
        2 * cw + 12 * P.dpi() / 96,
        ch
    );
    nested := workspace.tabs[0].nodes[root].second;
    #assert M.drag_divider(
        &workspace,
        nested,
        bounds,
        gap,
        bounds.y + bounds.height * 3 / 5,
        2 * cw + 12 * P.dpi() / 96,
        ch
    );
    rects: [32]M.Rect;
    U.geometry(&workspace, base, &rects);
    for i: 1..5 {
        id := cast(s32) i;
        layout := U.pane_layout(base, rects[id - 1]);
        #assert U.open(
            &book,
            id,
            cfg,
            "cmd.exe /d /q /c exit 0",
            U.columns(layout, cw),
            U.rows(layout, ch)
        );
    }
    // Transfer the exercised VT/Unicode buffer into the first visible pane.
    T.release(&book.panes[0].terminal);
    book.panes[0].terminal = terminal.*;
    empty: T.Terminal;
    terminal.* = empty;
    T.feed(
        &book.panes[1].terminal,
        "\x1b[1;38;2;129;161;193mVertical split\x1b[0m\r\n\r\nIndependent shell and scrollback\r\n\r\nC:\\> "
    );
    T.feed(
        &book.panes[2].terminal,
        "\x1b[1;38;2;98;192;160mHorizontal split\x1b[0m\r\n\r\nLua bindings reload on save\r\n\r\nC:\\> "
    );
    #assert U.resize(&book, &workspace, base, cw, ch);
    P.invalidate_frame();
    render_workspace(&book, &workspace, cfg, base, cw, ch, cfg.font_size);
    if capture_path.count > 0
        #assert P.snapshot(capture_path.c_string()) != 0, "save rendered tabs and panes";
}

main :: () -> s32 {
    active_window = &initial_window;
    cfg := C.defaults();
    defer C.release(&cfg);
    args := get_cmdline_args();
    explicit_config := false;
    config_path: str = "";
    capture_path: str = "";
    smoke := false;
    discrete_gpu := false;
    show_help := false;
    i: ssize = 1;
    while i < args.count {
        a := args[i];
        if a == "--help" || a == "-h" show_help = true;
        else if a == "--smoke-test" smoke = true;
        else if a == "--discrete-gpu" discrete_gpu = true;
        else if a == "--config" {
            i += 1;
            if i >= args.count {
                help();
                exit(2);
            }
            config_path = args[i];
            explicit_config = true;
        } else if a == "--capture" {
            i += 1;
            if i >= args.count {
                help();
                exit(2);
            }
            capture_path = args[i];
        } else if a == "--shell" || a == "--command" || a == "--profile" {
            i += 1;
            if i >= args.count {
                help();
                exit(2);
            }
        } else if a != "--hold" {
            print("Unknown argument: {}\n", a);
            help();
            exit(2);
        }
        i += 1;
    }
    if show_help {
        help();
        return 0;
    }
    if explicit_config config_path = config_path.clone();
    else               config_path = Config_Paths.select_path();
    defer config_path.free();
    config_watch: W.Watch;
    W.start(&config_watch, config_path, P.ticks());
    defer W.close(&config_watch);
    if (explicit_config || P.file_exists(config_path.c_string()) != 0) && !C.load(config_path, &cfg) {
        if !smoke
            P.error_dialog(
                tprint(
                    "Could not load Lua configuration:\n{}\n\n{}",
                    config_path,
                    C.error_message()
                ).c_string()
            );
        exit(2);
    }
    reload_state: R.State;
    R.start(&reload_state, &cfg);
    defer R.close(&reload_state);
    i = 1;
    while i < args.count {
        a := args[i];
        if a == "--shell" {
            i += 1;
            cfg.shell.free();
            cfg.shell = args[i].clone();
            cfg.command.free();
            cfg.command = "".clone();
            cfg.default_profile.free();
            cfg.default_profile = "".clone();
        } else if a == "--command" {
            i += 1;
            cfg.command.free();
            cfg.command = args[i].clone();
            cfg.default_profile.free();
            cfg.default_profile = "".clone();
        } else if a == "--profile" {
            i += 1;
            cfg.default_profile.free();
            cfg.default_profile = args[i].clone();
        } else if a == "--hold" cfg.close_on_exit = false;
        else if a == "--config" || a == "--capture" i += 1;
        i += 1;
    }
    if cfg.shell != "powershell" && cfg.shell != "cmd" && cfg.shell != "nushell" {
        if !smoke
            P.error_dialog(
                tprint("Unknown shell: {}\nChoose powershell, cmd, or nushell.", cfg.shell).c_string()
            );
        exit(2);
    }
    if cfg.default_profile.count > 0 && C.profile_index(&cfg, cfg.default_profile) < 0 {
        if !smoke P.error_dialog(tprint("Unknown profile: {}", cfg.default_profile).c_string());
        exit(2);
    }
    if smoke {
        smoke_test(&cfg, capture_path, discrete_gpu);
        return 0;
    }
    if capture_path.count > 0 {
        P.error_dialog("--capture requires --smoke-test");
        exit(2);
    }
    app := &initial_window;
    app.cfg = C.take(&cfg);
    app.config_watch = config_watch;
    config_watch = .{};
    app.reload_state = reload_state;
    reload_state = .{};
    app.base_font_size = app.reload_state.configured_font_size;
    app.discrete_gpu = discrete_gpu;
    if !open_window(app, false) {
        P.error_dialog(P.error());
        release_window(app);
        return 1;
    }
    if !open_surface(&app.book, &app.workspace, &app.cfg, app.layout, app.cw, app.ch, 0) {
        P.error_dialog(reload_notice().c_string());
        release_window(app);
        return 1;
    }
    windows.push(app);
    defer windows.free();
    defer N.close_sessions();
    clock_frequency(&performance_frequency);
    status: s32;
    while windows.count > 0 {
        reset_temporary_storage();
        index: ssize;
        while index < windows.count {
            app = windows[index];
            if select_window(app) {
                if step_window(app) {
                    index += 1;
                    continue;
                }
            } else {
                app.failed = true;
            }
            if app.failed status = 1;
            _ := windows.swap_remove(index);
            release_window(app);
        }
        if windows.count > 0 P.wait(window_wait());
    }
    return status;
}

select_window :: (app: *App_Window) -> bool {
    if !P.select_window(?&app.surface) return false;
    active_window = app;
    return true;
}

open_window :: (app: *App_Window, hidden: bool) -> bool {
    if !select_window(app) return false;
    cfg := &app.cfg;
    if P.open(
        cfg.font_family.c_string(),
        cfg.font_size,
        cfg.columns,
        cfg.rows,
        cfg.padding,
        cast(s32) hidden,
        cfg.window_opacity,
        app.discrete_gpu
    ) == 0 return false;
    app.hwnd = N.gui_window_handle();
    if !install_keybindings(cfg) return false;
    P.set_colors(cfg.selection_fg, cfg.selection_bg, cfg.cursor_text);
    P.set_ligatures(cfg.font_ligatures);
    size_window(app);
    return true;
}

size_window :: (app: *App_Window) {
    refresh_layout(&app.book, &app.workspace, &app.cfg, &app.layout, &app.width, &app.height, &app.cw, &app.ch);
    P.invalidate_frame();
    app.dirty = true;
}

release_window :: (app: *App_Window) {
    if app.tab_drag.index >= 0 || drop_window == ?app set_tab_drop(null, -1);
    selected := select_window(app);
    U.release(&app.book);
    W.close(&app.config_watch);
    R.close(&app.reload_state);
    C.release(&app.cfg);
    app.previous_title.free();
    if selected P.close_surface();
    _ := P.select_window(null);
    active_window = &initial_window;
    if app != &initial_window delete(?app);
}

window_wait :: () -> s32 {
    now := P.ticks();
    wait_ms := clamp(cast(s32)(550 - now % 550), 0, 100);
    for app: windows {
        if app.dirty && app.width > 0 && app.height > 0 return 0;
        if !app.config_watch.active continue;
        next_poll := app.config_watch.last_poll + 250;
        if now >= next_poll return 0;
        remaining := cast(s32)(next_poll - now);
        if remaining < wait_ms wait_ms = remaining;
    }
    return wait_ms;
}

window_at :: (screen: N.Point) -> ?*App_Window {
    hwnd := N.window_at(screen);
    for app: windows if app.hwnd == hwnd return ?app;
    return null;
}

tab_drop_index :: (app: *App_Window, screen: N.Point) -> s32 {
    if app.chrome.menu_open return -1;
    client := screen;
    if !N.screen_to_client(app.hwnd, &client) return -1;
    header := Chrome.geometry(app.width, cast(s32) app.layout.header_height, app.dpi,
        app.workspace.count, app.workspace.active);
    return Chrome.tab_insertion(&header, client.x, client.y);
}

set_tab_drop :: (target: ?*App_Window, index: s32) {
    if drop_window != target {
        if #pattern ?previous = drop_window {
            previous.chrome.drop_index = -1;
            previous.dirty = true;
        }
        drop_window = target;
    }
    if #pattern ?app = target {
        if app.chrome.drop_index != index {
            app.chrome.drop_index = index;
            app.dirty = true;
        }
    }
}

cancel_tab_drag :: (app: *App_Window) {
    if app.tab_drag.index < 0 return;
    app.tab_drag = .{};
    set_tab_drop(null, -1);
    P.cancel_pointer();
}

detach_tab :: (source: *App_Window, index: s32, screen: N.Point) -> bool {
    if source.workspace.count == 1 return N.position_window(screen);
    visible := N.window_visible();
    if #pattern ?target = new(App_Window) {
        target.cfg = C.clone(&source.cfg);
        target.config_watch = source.config_watch;
        target.config_watch.path = source.config_watch.path.clone();
        R.start(&target.reload_state, &source.reload_state.file_config);
        target.base_font_size = source.base_font_size;
        target.discrete_gpu = source.discrete_gpu;
        if open_window(target, true) && N.position_window(screen) && (!visible || N.window_show(false) != 0) &&
           U.transfer_tab(&source.book, &source.workspace, index, &target.book, &target.workspace, 0) {
            windows.push(target);
            size_window(target);
            _ := select_window(source);
            size_window(source);
            if visible N.activate_window(target.hwnd);
            return true;
        }
        release_window(target);
        _ := select_window(source);
    }
    return false;
}

move_tab_drag :: (source: *App_Window, x: s32, y: s32, released: bool) {
    drag := &source.tab_drag;
    if !drag.moving {
        threshold := N.drag_threshold();
        dx := x - drag.start.x;
        dy := y - drag.start.y;
        drag.moving = dx <= -threshold.x || dx >= threshold.x || dy <= -threshold.y || dy >= threshold.y;
    }
    index := drag.index;
    should_drop := drag.moving;
    if released {
        source.tab_drag = .{};
        set_tab_drop(null, -1);
    }
    screen: N.Point;
    if !should_drop || !N.client_to_screen(x, y, &screen) return;
    if #pattern ?target = window_at(screen) {
        position := tab_drop_index(target, screen);
        if position >= 0 {
            drop_on_rail(source, target, index, position, released);
            return;
        }
        if target != source || y < cast(s32) source.layout.header_height {
            set_tab_drop(null, -1);
            return;
        }
    }
    if !released set_tab_drop(null, -1);
    else if !detach_tab(source, index, screen) {
        set_reload_notice("Could not open a window for this tab.", true);
        source.dirty = true;
    }
}

drop_on_rail :: (source: *App_Window, target: *App_Window, index: s32, position: s32, released: bool) {
    if !released {
        if target == source || U.can_transfer_tab(&source.workspace, index, &target.book, &target.workspace)
            set_tab_drop(?target, position);
        else set_tab_drop(null, -1);
        return;
    }
    if target == source {
        next := position;
        if next > index next -= 1;
        if M.move_tab(&source.workspace, index, next) size_window(source);
        return;
    }
    if !U.transfer_tab(&source.book, &source.workspace, index, &target.book, &target.workspace, position) {
        set_reload_notice("The destination window has no room for this tab.", true);
        source.dirty = true;
        return;
    }
    U.end_drag(&target.book);
    if select_window(target) size_window(target);
    _ := select_window(source);
    size_window(source);
    N.activate_window(target.hwnd);
}

step_window :: (app: *App_Window) -> bool {
    cfg := &app.cfg;
    book := &app.book;
    workspace := &app.workspace;
    config_watch := &app.config_watch;
    reload_state := &app.reload_state;
    if workspace.count == 0 return false;
    event: P.Event;
    while P.next_event(&event) != 0 {
        if workspace.count == 0 return false;
        if app.tab_drag.index >= 0 {
            if event.kind == 7 || event.kind == 8 {
                app.chrome.x = event.a;
                app.chrome.y = event.b;
                move_tab_drag(app, event.a, event.b, event.kind == 8);
                app.dirty = true;
                if workspace.count == 0 return false;
                continue;
            }
            cancel_tab_drag(app);
            if event.kind == 11 || (event.kind == 1 && event.a == 27) ||
               (event.kind == 2 && event.length == 1 && event.text[0] == 27) continue;
        }
        if event.kind == P.Gui_Failure {
            reason := P.error().to_string().clone();
            defer reason.free();
            if P.ticks() < app.next_graphics_retry {
                P.error_dialog(tprint(
                    "The terminal window failed again shortly after reopening. Restart wst.\n\n{}",
                    reason
                ).c_string());
                app.failed = true;
                return false;
            }
            if P.recover_window() == 0 || !install_keybindings(cfg) {
                P.error_dialog(tprint(
                    "Could not restore the terminal window. Restart wst.\n\nWindow update failed\n{}\n\nRecovery failed\n{}",
                    reason, P.error().to_string()
                ).c_string());
                app.failed = true;
                return false;
            }
            // A repeatedly failing device must not endlessly recreate the window.
            app.next_graphics_retry = P.ticks() + 10000;
            app.hwnd = N.gui_window_handle();
            P.title(app.previous_title.c_string());
            app.chrome = .{};
            app.divider_drag = .{};
            app.notice_click = false;
            U.end_drag(book);
            app.dirty = true;
            continue;
        }
        // Coalesce terminal/ConPTY resizing until the pointer batch ends.
        // Other events must see the latest pane rectangles for hit testing.
        if app.divider_drag.pending && event.kind != 7 && event.kind != 8 {
            apply_divider(book, workspace, app.layout, app.cw, app.ch);
            app.dirty = true;
        }
        if app.divider_drag.active && event.kind != 7 && event.kind != 8 {
            _ := cancel_divider();
            app.dirty = true;
            if (event.kind == 1 && event.a == 27) ||
               (event.kind == 2 && event.length == 1 && event.text[0] == 27)
                continue;
        }
        focused := M.focused(workspace);
        p := &book.panes[focused - 1];
        _ := P.pty_select(p.handle);
        t := &p.terminal;
        selection := &p.selection;
        if app.chrome.menu_open && (event.kind == 1 || event.kind == 2) {
            header := Chrome.geometry(
                app.width,
                cast(s32) app.layout.header_height,
                P.dpi(),
                workspace.count,
                workspace.active
            );
            if event.kind == 1 && (event.a == 38 || event.a == 40) {
                if event.a == 38 app.chrome.selected -= 1;
                else             app.chrome.selected += 1;
                Chrome.keep_selected(&app.chrome, &header, app.height, cfg.profile_count + 7);
                app.dirty = true;
                continue;
            }
            if event.kind == 2 {
                if event.length == 1 && event.text[0] == 13
                    menu_action(
                        app.chrome.selected,
                        book,
                        workspace,
                        cfg,
                        &app.layout,
                        &app.cw,
                        &app.ch,
                        &app.width,
                        &app.height,
                        app.base_font_size
                    );
                else if event.length == 1 && event.text[0] == 27
                    app.chrome.menu_open = false;
                app.dirty = true;
                continue;
            }
            app.chrome.menu_open = false;
            app.dirty = true;
        }
        if event.kind == 4 {
            return false;
        } else if event.kind == 3 {
            app.chrome.menu_open = false;
            app.chrome.pressed = 0;
            refresh_layout(book, workspace, cfg, &app.layout, &app.width, &app.height, &app.cw, &app.ch);
            U.end_drag(book);
            P.invalidate_frame();
            app.dirty = true;
        } else if event.kind == 2 && !p.exited {
            send(string_from_raw_parts(cast([*]const u8) &event.text, event.length));
            if t.view_offset != 0 || selection.active app.dirty = true;
            t.view_offset = 0;
            selection.active = false;
        } else if event.kind == 1 {
            action := K.lookup(&cfg.keybindings, event.a, event.b);
            if event.a == 32 && event.b == 4 && action == .None {
                _ := P.window_menu(0, cast(s32) app.layout.header_height);
                app.dirty = true;
                continue;
            }
            if cast(s32) action >= cast(s32) K.Action.New_Tab {
                workspace_action(
                    action,
                    book,
                    workspace,
                    cfg,
                    app.layout,
                    app.cw,
                    app.ch,
                    K.profile_for(&cfg.keybindings, event.a, event.b)
                );
                if workspace.count == 0 {
                    return false;
                }
                app.dirty = true;
                continue;
            }
            if action == .Copy copy_selection(t, selection);
            else if action == .Paste {
                if paste_clipboard(t, selection, p.exited) app.dirty = true;
            } else if action == .Zoom_In || action == .Zoom_Out || action == .Reset_Zoom {
                zoom: s32 = 1;
                if action == .Zoom_Out   zoom = -1;
                if action == .Reset_Zoom zoom = 2;
                set_zoom(cfg, V.font_size(cfg.font_size, app.base_font_size, zoom));
                refresh_layout(book, workspace, cfg, &app.layout, &app.width, &app.height, &app.cw, &app.ch);
                app.dirty = true;
            } else if action == .Scroll_Page_Up || action == .Scroll_Page_Down || action == .Scroll_Top ||
                action == .Scroll_Bottom || action == .Scroll_Line_Up || action == .Scroll_Line_Down {
                if action == .Scroll_Page_Up
                    T.scroll_view(t, clamp(t.rows - 1, 1, 256));
                else if action == .Scroll_Page_Down
                    T.scroll_view(t, -clamp(t.rows - 1, 1, 256));
                else if action == .Scroll_Top
                    T.scroll_view(t, 10000);
                else if action == .Scroll_Bottom
                    t.view_offset = 0;
                else if action == .Scroll_Line_Up
                    T.scroll_view(t, 1);
                else
                    T.scroll_view(t, -1);
                selection.active = false;
                selection.dragging = false;
                p.scroll_dragging = false;
                app.dirty = true;
            } else if action == .Close_Window {
                return false;
            } else if !p.exited {
                send(I.key_sequence(event.a, event.b, t.application_cursor));
                t.view_offset = 0;
                selection.active = false;
                app.dirty = true;
            }
        } else if event.kind == 5 {
            wheel_x, wheel_y: s32;
            if P.pointer_position(&wheel_x, &wheel_y) {
                app.chrome.x = wheel_x;
                app.chrome.y = wheel_y;
            }
            if app.chrome.menu_open {
                header := Chrome.geometry(
                    app.width,
                    cast(s32) app.layout.header_height,
                    P.dpi(),
                    workspace.count,
                    workspace.active
                );
                app.chrome.selected += 3;
                if event.a > 0 app.chrome.selected -= 6;
                app.chrome.selected = clamp(app.chrome.selected, 0, cfg.profile_count + 6);
                Chrome.keep_selected(&app.chrome, &header, app.height, cfg.profile_count + 7);
                app.dirty = true;
                continue;
            }
            if app.chrome.y >= 0 && app.chrome.y < cast(s32) app.layout.header_height && (event.b & 2) == 0 {
                direction: s32 = 1;
                if event.a > 0 direction = -1;
                _ := M.cycle_tab(workspace, direction);
                publish_dividers(workspace, app.layout);
                U.end_drag(book);
                app.dirty = true;
                continue;
            }
            wheel := V.wheel(&p.wheel, event.a, event.b, event.c, t.rows - 1);
            if wheel.zoom_steps != 0 {
                set_zoom(cfg, cfg.font_size + wheel.zoom_steps);
                refresh_layout(book, workspace, cfg, &app.layout, &app.width, &app.height, &app.cw, &app.ch);
            }
            if wheel.scroll_lines != 0 T.scroll_view(t, wheel.scroll_lines);
            selection.active = false;
            selection.dragging = false;
            p.scroll_dragging = false;
            app.dirty = true;
        } else if event.kind == 6 {
            app.chrome.x = event.a;
            app.chrome.y = event.b;
            header := Chrome.geometry(
                app.width,
                cast(s32) app.layout.header_height,
                P.dpi(),
                workspace.count,
                workspace.active
            );
            h := Chrome.hit(&header, event.a, event.b);
            if app.chrome.menu_open {
                row := Chrome.menu_hit(
                    &header,
                    &app.chrome,
                    app.height,
                    cfg.profile_count + 7,
                    event.a,
                    event.b
                );
                if row >= 0 {
                    menu_action(
                        row,
                        book,
                        workspace,
                        cfg,
                        &app.layout,
                        &app.cw,
                        &app.ch,
                        &app.width,
                        &app.height,
                        app.base_font_size
                    );
                    app.dirty = true;
                    continue;
                }
                popup := Chrome.menu_rect(&header, app.height, cfg.profile_count + 7);
                if Chrome.contains(popup, event.a, event.b) {
                    if app.reload_notice_error && app.reload_notice_count > 0 &&
                       event.b < popup.y + Chrome.pixels(26, P.dpi())
                        P.error_dialog(reload_notice().c_string());
                    continue;
                }
                app.chrome.menu_open = false;
                app.dirty = true;
                if event.b >= header.height || h.kind == Chrome.Menu continue;
            }
            if h.kind == Chrome.Tab || h.kind == Chrome.Tab_Close {
                if h.kind == Chrome.Tab_Close close_tab(book, workspace, h.index, app.layout);
                else {
                    _ := M.activate(workspace, h.index);
                    app.tab_drag = .{ h.index, .{ event.a, event.b }, false };
                }
                publish_dividers(workspace, app.layout);
                U.end_drag(book);
                P.invalidate_frame();
                app.dirty = true;
                continue;
            }
            if h.kind == Chrome.New_Tab {
                _ := open_surface(book, workspace, cfg, app.layout, app.cw, app.ch, 0);
                app.dirty = true;
                continue;
            }
            if h.kind == Chrome.Menu {
                U.end_drag(book);
                app.chrome.menu_open = true;
                app.chrome.menu_scroll = 0;
                app.chrome.selected = 0;
                app.dirty = true;
                continue;
            }
            if h.kind == Chrome.Brand {
                U.end_drag(book);
                _ := P.window_menu(0, header.height);
                app.dirty = true;
                continue;
            }
            if h.kind >= Chrome.Minimize && h.kind <= Chrome.Close {
                U.end_drag(book);
                app.chrome.pressed = h.kind;
                app.dirty = true;
                continue;
            }
            zoom := zoom_action_at(app.layout, event.a, event.b);
            app.notice_click = notice_hit(app.layout, event.a, event.b);
            if app.notice_click {
                U.end_drag(book);
                continue;
            }
            if zoom != 0 {
                set_zoom(cfg, V.font_size(cfg.font_size, app.base_font_size, zoom));
                refresh_layout(book, workspace, cfg, &app.layout, &app.width, &app.height, &app.cw, &app.ch);
                app.dirty = true;
                continue;
            }
            if h.kind == Chrome.Drag {
                U.end_drag(book);
                _ := P.window_drag(event.a, event.b);
                continue;
            }
            divider := M.divider_at(
                workspace,
                U.body_rect(app.layout),
                6 * P.dpi() / 96,
                event.a,
                event.b
            );
            if divider.node >= 0 {
                U.end_drag(book);
                app.divider_drag.active = true;
                app.divider_drag.node = divider.node;
                app.divider_drag.axis = divider.axis;
                if divider.axis == M.Axis_Vertical app.divider_drag.grab = event.a - divider.rect.x;
                else                               app.divider_drag.grab = event.b - divider.rect.y;
                P.invalidate_frame();
                app.dirty = true;
                continue;
            }
            hit := M.pane_at(workspace, &book.rects, event.a, event.b);
            if hit == 0 continue;
            U.end_drag(book);
            if M.focus_pane(workspace, hit) {
                P.invalidate_frame();
                app.dirty = true;
            }
            p = &book.panes[hit - 1];
            t = &p.terminal;
            selection = &p.selection;
            _ := P.pty_select(p.handle);
            bar := scrollbar_geometry(t, p.layout);
            if event.a >= bar.x && event.a < bar.x + bar.width {
                if t.history_count > 0 && !t.alternate {
                    page := S.page_direction(bar, event.b);
                    if page != 0 T.scroll_view(t, page * clamp(t.rows - 1, 1, 256));
                    else if bar.thumb_height < bar.height {
                        p.scroll_dragging = true;
                        p.scroll_grab = event.b - bar.thumb_y;
                    }
                }
                selection.active = false;
            } else {
                selection.start = point_index(t, p.layout, app.cw, app.ch, event.a, event.b);
                selection.end = selection.start;
                selection.active = true;
                selection.dragging = true;
            }
            app.dirty = true;
        } else if event.kind == 7 || event.kind == 8 {
            app.chrome.x = event.a;
            app.chrome.y = event.b;
            if app.chrome.pressed != 0 {
                if event.kind == 8 {
                    header := Chrome.geometry(
                        app.width,
                        cast(s32) app.layout.header_height,
                        P.dpi(),
                        workspace.count,
                        workspace.active
                    );
                    h := Chrome.hit(&header, event.a, event.b);
                    pressed := app.chrome.pressed;
                    app.chrome.pressed = 0;
                    if h.kind == pressed _ := P.window_action(h.kind - Chrome.Minimize + 1);
                }
                app.dirty = true;
                continue;
            }
            if app.divider_drag.active {
                move_divider(workspace, app.layout, app.cw, app.ch, event.a, event.b);
                if event.kind == 8 {
                    _ := cancel_divider();
                    apply_divider(book, workspace, app.layout, app.cw, app.ch);
                }
                app.dirty = true;
            } else if app.notice_click {
                if event.kind == 8 {
                    if notice_hit(app.layout, event.a, event.b)
                        P.error_dialog(reload_notice().c_string());
                    app.notice_click = false;
                }
            } else if p.scroll_dragging {
                if !t.alternate
                    t.view_offset = S.offset_at(
                        scrollbar_geometry(t, p.layout),
                        t.history_count,
                        event.b,
                        p.scroll_grab
                    );
                app.dirty = true;
            } else if selection.dragging {
                selection.end = point_index(t, p.layout, app.cw, app.ch, event.a, event.b);
                app.dirty = true;
            }
            if event.kind == 8 {
                selection.dragging = false;
                p.scroll_dragging = false;
            }
        } else if event.kind == 11 {
            U.end_drag(book);
            app.notice_click = false;
            app.chrome.pressed = 0;
        } else if event.kind == 9 copy_selection(t, selection);
        else if event.kind == 10 {
            if app.chrome.menu_open {
                app.chrome.menu_open = false;
                app.dirty = true;
                continue;
            }
            if event.b < cast(s32) app.layout.header_height {
                U.end_drag(book);
                app.chrome.menu_open = false;
                _ := P.window_menu(event.a, event.b);
                app.dirty = true;
                continue;
            }
            hit := M.pane_at(workspace, &book.rects, event.a, event.b);
            if hit > 0 {
                if M.focus_pane(workspace, hit) {
                    U.end_drag(book);
                    P.invalidate_frame();
                    app.dirty = true;
                }
                p = &book.panes[hit - 1];
                _ := P.pty_select(p.handle);
            }
            if paste_clipboard(&p.terminal, &p.selection, p.exited) app.dirty = true;
        }
    }
    if workspace.count == 0 return false;
    hover_x, hover_y: s32;
    if P.pointer_position(&hover_x, &hover_y) && (hover_x != app.chrome.x || hover_y != app.chrome.y) {
        before := hover_signature(
            book,
            workspace,
            app.layout,
            app.height,
            cfg.profile_count,
            app.chrome.x,
            app.chrome.y
        );
        app.chrome.x = hover_x;
        app.chrome.y = hover_y;
        header := Chrome.geometry(
            app.width,
            cast(s32) app.layout.header_height,
            P.dpi(),
            workspace.count,
            workspace.active
        );
        row := Chrome.menu_hit(
            &header,
            &app.chrome,
            app.height,
            cfg.profile_count + 7,
            hover_x,
            hover_y
        );
        if app.chrome.menu_open && row >= 0 app.chrome.selected = row;
        if before != hover_signature(
            book,
            workspace,
            app.layout,
            app.height,
            cfg.profile_count,
            hover_x,
            hover_y
        )
            app.dirty = true;
    }
    header := Chrome.geometry(
        app.width,
        cast(s32) app.layout.header_height,
        P.dpi(),
        workspace.count,
        workspace.active
    );
    in_menu := app.chrome.menu_open && Chrome.contains(
        Chrome.menu_rect(&header, app.height, cfg.profile_count + 7),
        app.chrome.x,
        app.chrome.y
    );
    P.pointer_ui((app.chrome.y >= 0 && app.chrome.y < header.height) || in_menu);
    if app.divider_drag.pending {
        apply_divider(book, workspace, app.layout, app.cw, app.ch);
        app.dirty = true;
    }
    if W.poll(config_watch, P.ticks()) {
        cancel_tab_drag(app);
        app.chrome.menu_open = false;
        _ := cancel_divider();
        if R.reload_workspace(config_watch.path, cfg, book, workspace, reload_state) {
            app.base_font_size = reload_state.configured_font_size;
            P.metrics(&app.width, &app.height, &app.cw, &app.ch);
            app.dpi = P.dpi();
            app.layout = L.compute(app.width, app.height, cfg.padding, cast(f32) app.dpi / 96.0);
            publish_dividers(workspace, app.layout);
            if reload_state.session_replaced {
                app.previous_title.free();
                app.previous_title = "".clone();
            }
            set_reload_notice("Config reloaded", false);
        } else set_reload_notice(tprint("Config reload failed: {}", R.error_message()), true);
        app.notice_click = false;
        app.dirty = true;
    }
    output_started, output_now: s64;
    clock_counter(&output_started);
    // Round-robin output keeps background tabs alive without starving input.
    for 0..64 {
        app.output_cursor = (app.output_cursor + 1) % 32;
        p := &book.panes[app.output_cursor];
        if !p.used continue;
        _ := P.pty_select(p.handle);
        count := P.pty_read(cast([*]u8) &output_buffer, 4096);
        if count > 0 {
            T.feed(&p.terminal, string_from_raw_parts(cast([*]const u8) &output_buffer, count));
            if p.selection.active && p.terminal.view_offset == 0 && !p.selection.dragging
                p.selection.active = false;
            p.last_output = P.ticks();
            app.dirty = true;
        }
        if p.terminal.replies.count > 0 {
            send(cast(str) p.terminal.replies.view());
            p.terminal.replies.clear();
        }
        clock_counter(&output_now);
        if output_now - output_started >= performance_frequency / 250 break;
    }
    for index: 0..32 if book.panes[index].used {
        p := &book.panes[index];
        _ := P.pty_select(p.handle);
        if !p.exited && P.pty_status(&p.code) == 1 {
            p.exited = true;
            p.exit_seen = P.ticks();
            app.dirty = true;
        }
        if p.exited && cfg.close_on_exit && P.ticks() - p.exit_seen > 250 && P.ticks() - p.last_output > 200 {
            cancel_tab_drag(app);
            close_pane(book, workspace, cast(s32) index + 1, app.layout, app.cw, app.ch);
            app.dirty = true;
        }
    }
    if workspace.count == 0 return false;
    focused := M.focused(workspace);
    p := &book.panes[focused - 1];
    _ := P.pty_select(p.handle);
    caption: str = p.launch.name;
    if p.terminal.title.count > 0 {
        if p.launch.profile_id.count == 0
            caption = cast(str) p.terminal.title.view();
        else
            caption = tprint("{}: {}", p.launch.name, cast(str) p.terminal.title.view());
    }
    title := tprint("{} | wst [{}/{}]", caption, workspace.active + 1, workspace.count);
    if title != app.previous_title {
        app.previous_title.free();
        app.previous_title = title.clone();
        P.title(title.c_string());
    }
    blink := P.ticks() / 550;
    if blink != app.last_blink {
        app.dirty = true;
        app.last_blink = blink;
    }
    if app.dirty && app.width > 0 && app.height > 0 {
        render_workspace(book, workspace, cfg, app.layout, app.cw, app.ch, app.base_font_size);
        app.dirty = false;
    }
    return true;
}

string_from_raw_parts :: (data: [*]const u8, count: ssize) -> str #magic "string_from_raw_parts";
