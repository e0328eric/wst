//! std.Gui ordered input adapted to the terminal's stable event vocabulary.
G :: #import "Gui";
T :: #import "platform_types.glo";
N :: #import "native.glo";
kernel32 :: #library,system "kernel32";
GetLastError :: () -> u32 #foreign kernel32;
#export "platform_types.glo" {
    Event, Key_Binding, Divider_Hit
};

#public Text_Prediction :: struct {
    codepoint: u32;
    alternate: u32;
    suppress: bool;
}
#public Window_State :: struct {
    window: G.Window;
    events: [..]T.Event;
    event_head: ssize;
    batch_open: bool;
    render_input_ready: bool;
    closed_reported: bool;
    bindings: [128]T.Key_Binding;
    binding_count: s32;
    dividers: [31]T.Divider_Hit;
    divider_count: s32;
    left_down: bool;
    right_down: bool;
    right_alt: bool;
    pointer_known: bool;
    pointer_x: s32;
    pointer_y: s32;
    pointer_in_ui: bool;
    captured_axis: s32;
    wheel_remainder: f32;
    predictions: [..]Text_Prediction;
    prediction_head: ssize;
    last_error: str = "";
}
default_state: Window_State;
selected_state: ?*Window_State;

#public select_state :: (value: ?*Window_State) {
    selected_state = value;
}

state :: () -> *Window_State #inline,always {
    if #pattern ?selected = selected_state return selected;
    return &default_state;
}

#public {

bind_window :: (value: G.Window) {
    close();
    state().window = value;
}

close :: () {
    live := state();
    live.events.reset();
    live.predictions.reset();
    live.event_head = 0;
    live.prediction_head = 0;
    live.batch_open = false;
    live.render_input_ready = false;
    live.closed_reported = false;
    live.binding_count = 0;
    live.divider_count = 0;
    live.left_down = false;
    live.right_down = false;
    live.right_alt = false;
    live.pointer_known = false;
    live.pointer_in_ui = false;
    live.captured_axis = 0;
    live.wheel_remainder = 0;
    live.last_error = "";
    empty: G.Window;
    live.window = empty;
}

error_message :: () -> str {
    return state().last_error;
}
/// Latest Gui pointer coordinates in physical pixels, including idle hover.
pointer_position :: (x: *s32, y: *s32) -> bool {
    live := state();
    if !live.pointer_known return false;
    x.* = live.pointer_x;
    y.* = live.pointer_y;
    return true;
}
pointer_ui :: (enabled: bool) {
    state().pointer_in_ui = enabled;
    refresh_cursor();
}

validate_keybindings :: (items: [*]const T.Key_Binding, count: s32) -> s32 {
    state().last_error = "";
    if count < 0 || count > 128 || (count > 0 && cast(usize) items == 0)
        return invalid("Invalid keyboard shortcut count or pointer");
    for i: 0..count {
        item := items[i];
        if item.key < 1 || item.key > 255 || item.mods < 0 || item.mods > 7 ||
           item.action < 1 || item.action > 25
            return invalid("Invalid keyboard shortcut entry");
        if item.key == 115 && (item.mods & 4) != 0
            return invalid("Alt+F4 is reserved for closing the window");
        for j: 0..i if items[j].key == item.key && items[j].mods == item.mods
            return invalid("Keyboard shortcuts must use distinct chords");
    }
    return 1;
}

set_keybindings :: (items: [*]const T.Key_Binding, count: s32) -> s32 {
    live := state();
    if validate_keybindings(items, count) == 0 return 0;
    for i: 0..count live.bindings[i] = items[i];
    live.binding_count = count;
    return 1;
}

notify_resize :: () {
    push(3, 0, 0, 0);
}

set_dividers :: (items: [*]const T.Divider_Hit, count: s32) -> s32 {
    live := state();
    live.last_error = "";
    if count < 0 || count > 31 || (count > 0 && cast(usize) items == 0)
        return invalid("Invalid divider count or pointer");
    for i: 0..count {
        item := items[i];
        if item.width <= 0 || item.height <= 0 || (item.axis != 1 && item.axis != 2)
            return invalid("Divider rectangles must be nonempty and have a valid axis");
    }
    for i: 0..count live.dividers[i] = items[i];
    live.divider_count = count;
    refresh_cursor();
    return 1;
}

cursor_axis :: () -> s32 {
    // Prevent #assert from folding the initial cursor state at compile time.
    _ := GetLastError();
    return current_cursor_axis();
}

cancel_pointer :: () {
    cancel_buttons();
    N.cancel_pointer();
}

/// A complete Gui input snapshot must precede each render frame. Copying events
/// here keeps a smoke-test render or capture from discarding input for next_event.
ensure_render_input :: () -> bool {
    live := state();
    if live.render_input_ready      return true;
    if !G.window_valid(live.window) return false;
    pump();
    return live.render_input_ready;
}

frame_presented :: () {
    state().render_input_ready = false;
}

next_event :: (event: *T.Event) -> s32 {
    live := state();
    if live.event_head < live.events.count {
        event.* = live.events[live.event_head];
        live.event_head += 1;
        return 1;
    }
    if live.batch_open {
        live.events.clear();
        live.event_head = 0;
        live.batch_open = false;
        return 0;
    }
    if !G.window_valid(live.window) return 0;
    pump();
    if live.event_head < live.events.count {
        event.* = live.events[live.event_head];
        live.event_head += 1;
        return 1;
    }
    live.batch_open = false;
    return 0;
}

/// Conversion is separate from polling so ordered input can be regression-tested
/// without injecting input into the user's physical keyboard or pointer.
feed_event :: (event: G.Input_Event) {
    live := state();
    if event.kind == .Key {
        if event.key == .RightAlt   live.right_alt = event.action != .Release;
        if event.action == .Release return;
        key := legacy_key(event);
        if key == 0 || modifier_key(key) return;
        mods := legacy_modifiers(event.modifiers);
        action := bound_action(key, mods);
        if action != 0 {
            predict_text(key, event.scancode, mods, true);
            push(1, key, mods, action);
            return;
        }
        // The client-side header restores the native system-menu shortcut.
        // Configured Alt+Space actions still take precedence above.
        if key == 32 && mods == 4 {
            predict_text(key, event.scancode, mods, true);
            push(1, key, mods, 0);
            return;
        }
        if key == 115 && (mods & 4) != 0 {
            push_close();
            return;
        }
        if navigation_key(key) || (key == 9 && (mods & 1) != 0) {
            push(1, key, mods, 0);
            return;
        }
        if key == 8 || key == 9 || key == 13 || key == 27 {
            cp: u32 = cast(u32) key;
            controls: [8]u32;
            count := N.key_text(key, cast(s32) event.scancode, mods & 3, cast([*]u32) &controls, 8);
            if count > 0 cp = controls[0];
            if cp == 8   cp = 127;
            text(cp, (mods & 4) != 0 && (mods & 2) == 0);
            return;
        }
        // AltGr is text, while ordinary Ctrl/Alt combinations need terminal
        // control bytes because Gui intentionally leaves them out of Text.
        altgr := live.right_alt && (mods & 6) == 6;
        if (mods & 6) != 0 && !altgr {
            codepoints: [8]u32;
            count := N.key_text(
                key,
                cast(s32) event.scancode,
                mods & 3,
                cast([*]u32) &codepoints,
                8
            );
            for i: 0..count text(codepoints[i], (mods & 4) != 0 && (mods & 2) == 0);
            return;
        }
        if (event.modifiers & .Super) != .None return;
        predict_text(key, event.scancode, mods, false);
    } else if event.kind == .Text {
        suppress := false;
        for i: live.prediction_head..live.predictions.count {
            if live.predictions[i].codepoint == event.codepoint || live.predictions[i].alternate == event.codepoint {
                suppress = live.predictions[i].suppress;
                live.prediction_head = i + 1;
                break;
            }
        }
        if !suppress text(event.codepoint, false);
    } else if event.kind == .Resize {
        push(3, event.width, event.height, 0);
    } else if event.kind == .Focus {
        if event.action == .Release {
            cancel_buttons();
            live.right_alt = false;
        }
        push(3, 0, 0, 0);
    } else if event.kind == .Close {
        cancel_buttons();
        push_close();
    } else if event.kind == .PointerMove || event.kind == .PointerButton || event.kind == .Scroll {
        scale := G.content_scale(live.window);
        if scale <= 0 scale = 1;
        live.pointer_x = physical(event.x * scale);
        live.pointer_y = physical(event.y * scale);
        live.pointer_known = true;
        if event.kind == .PointerMove {
            refresh_cursor();
            if live.left_down push(7, live.pointer_x, live.pointer_y, 0);
        } else if event.kind == .PointerButton {
            if event.action == .Press || event.action == .Repeat {
                if event.button == .Left {
                    live.left_down = true;
                    live.captured_axis = divider_axis(live.pointer_x, live.pointer_y);
                    refresh_cursor();
                    push(6, live.pointer_x, live.pointer_y, legacy_modifiers(event.modifiers));
                } else if event.button == .Right live.right_down = true;
            } else if event.action == .Release {
                reason := N.pointer_release(cast(s32) event.button);
                if reason == 2 {
                    cancel_buttons();
                    return;
                }
                if event.button == .Left && live.left_down {
                    live.left_down = false;
                    live.captured_axis = 0;
                    refresh_cursor();
                    push(8, live.pointer_x, live.pointer_y, 0);
                } else if event.button == .Right && live.right_down {
                    live.right_down = false;
                    push(10, live.pointer_x, live.pointer_y, 0);
                }
            }
        } else if event.dy != 0 {
            live.wheel_remainder += event.dy * 120;
            delta := cast(s32) live.wheel_remainder;
            live.wheel_remainder -= cast(f32) delta;
            if delta != 0 push(5, delta, legacy_modifiers(event.modifiers), N.scroll_lines());
        }
    }
}

}

invalid :: (message: str) -> s32 {
    state().last_error = message;
    return 0;
}

pump :: () {
    live := state();
    live.predictions.clear();
    live.prediction_head = 0;
    live.render_input_ready = G.update_window_events(live.window);
    live.batch_open = true;
    batch := G.input_events(live.window);
    for i: 0..batch.count feed_event(G.input_event(batch, cast(u32) i));
    if !live.render_input_ready && !live.closed_reported {
        if N.window_close_requested() push_close();
        else {
            _ := N.set_error(G.last_error().c_string());
            push(T.Gui_Failure, 0, 0, 0);
        }
    }
}

push_close :: () {
    live := state();
    if !live.closed_reported {
        push(4, 0, 0, 0);
        live.closed_reported = true;
    }
}

push :: (kind: s32, a: s32, b: s32, c: s32) {
    live := state();
    value: T.Event;
    value.kind = kind;
    value.a = a;
    value.b = b;
    value.c = c;
    if kind == 7 && live.events.count > live.event_head && live.events[live.events.count - 1].kind == 7 {
        live.events[live.events.count - 1] = value;
        return;
    }
    live.events.push(value);
}

text :: (cp: u32, alt: bool) {
    value: T.Event;
    value.kind = 2;
    scalar := cp;
    if scalar > 16#10ffff || (scalar >= 16#d800 && scalar <= 16#dfff) scalar = 16#fffd;
    if alt {
        value.text[0] = 27;
        value.length = 1;
    }
    at := value.length;
    if scalar < 128 {
        value.text[at] = cast(u8) scalar;
        value.length += 1;
    } else if scalar < 2048 {
        value.text[at] = cast(u8)(192 | scalar >> 6);
        value.text[at + 1] = cast(u8)(128 | scalar & 63);
        value.length += 2;
    } else if scalar < 65536 {
        value.text[at] = cast(u8)(224 | scalar >> 12);
        value.text[at + 1] = cast(u8)(128 | (scalar >> 6) & 63);
        value.text[at + 2] = cast(u8)(128 | scalar & 63);
        value.length += 3;
    } else {
        value.text[at] = cast(u8)(240 | scalar >> 18);
        value.text[at + 1] = cast(u8)(128 | (scalar >> 12) & 63);
        value.text[at + 2] = cast(u8)(128 | (scalar >> 6) & 63);
        value.text[at + 3] = cast(u8)(128 | scalar & 63);
        value.length += 4;
    }
    state().events.push(value);
}

predict_text :: (key: s32, scancode: u32, mods: s32, suppress: bool) {
    points: [8]u32;
    alternate: [8]u32;
    count := N.key_text(key, cast(s32) scancode, mods, cast([*]u32) &points, 8);
    alternate_count := N.key_text(key, cast(s32) scancode, mods ^ 1, cast([*]u32) &alternate, 8);
    for i: 0..count if points[i] >= 32 && !(points[i] >= 127 && points[i] < 160) {
        other := points[i];
        // Text is an independent Gui stream. Caps Lock can change during the
        // same native batch, and software test messages do not mutate Windows'
        // physical Shift state. Both layout variants identify this key's text.
        if alternate_count == count && alternate[i] >= 32 &&
           !(alternate[i] >= 127 && alternate[i] < 160)
            other = alternate[i];
        state().predictions.push(.{ points[i], other, suppress });
    }
}

bound_action :: (key: s32, mods: s32) -> s32 {
    live := state();
    for i: 0..live.binding_count if live.bindings[i].key == key && live.bindings[i].mods == mods return live.bindings[i].action;
    return 0;
}

legacy_modifiers :: (mods: G.Modifiers) -> s32 {
    result: s32;
    if (mods & .Shift) != .None result |= 1;
    if (mods & .Ctrl) != .None  result |= 2;
    if (mods & .Alt) != .None   result |= 4;
    return result;
}

legacy_key :: (event: G.Input_Event) -> s32 {
    scan := event.scancode;
    if scan == 16#4e  return 107;
    if scan == 16#4a  return 109;
    if scan == 16#37  return 106;
    if scan == 16#135 return 111;
    if event.key == .Unknown || event.key == .Period {
        if scan == 16#52 return 96;
        if scan == 16#4f return 97;
        if scan == 16#50 return 98;
        if scan == 16#51 return 99;
        if scan == 16#4b return 100;
        if scan == 16#4c return 101;
        if scan == 16#4d return 102;
        if scan == 16#47 return 103;
        if scan == 16#48 return 104;
        if scan == 16#49 return 105;
        if scan == 16#53 return 110;
    }
    return cast(s32) event.key;
}

modifier_key :: (key: s32) -> bool {
    return key == 16 || key == 17 || key == 18 || (key >= 160 && key <= 165) ||
        key == 20 || key == 91 || key == 92;
}

navigation_key :: (key: s32) -> bool {
    return (key >= 33 && key <= 40) || key == 45 || key == 46 || (key >= 112 && key <= 123);
}

divider_axis :: (x: s32, y: s32) -> s32 {
    live := state();
    for i: 0..live.divider_count {
        rect := live.dividers[i];
        if cast(s64) x >= cast(s64) rect.x && cast(s64) y >= cast(s64) rect.y &&
           cast(s64) x < cast(s64) rect.x + cast(s64) rect.width &&
           cast(s64) y < cast(s64) rect.y + cast(s64) rect.height
            return rect.axis;
    }
    return 0;
}

current_cursor_axis :: () -> s32 {
    live := state();
    if live.left_down     return live.captured_axis;
    if live.pointer_known return divider_axis(live.pointer_x, live.pointer_y);
    return 0;
}

refresh_cursor :: () {
    live := state();
    if !live.pointer_known return;
    if live.pointer_in_ui N.pointer_arrow();
    else                  N.pointer_cursor(current_cursor_axis());
}

cancel_buttons :: () {
    live := state();
    if live.left_down || live.right_down {
        live.left_down = false;
        live.right_down = false;
        live.captured_axis = 0;
        push(11, 0, 0, 0);
        refresh_cursor();
    }
}

physical :: (value: f32) -> s32 {
    if value < 0 return cast(s32)(value - 0.5);
    return cast(s32)(value + 0.5);
}
