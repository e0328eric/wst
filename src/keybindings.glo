//! Keyboard actions and counted chord tables shared by Lua config and Win32.
//! A Bindings value owns no memory and can be copied transactionally.
#import "Io";
#import "Format";

binding_last_error_storage: [1024]u8;
binding_last_error_count: ssize;

#public {

Action :: enum {
    None;
    Copy;
    Paste;
    Zoom_In;
    Zoom_Out;
    Reset_Zoom;
    Scroll_Page_Up;
    Scroll_Page_Down;
    Scroll_Top;
    Scroll_Bottom;
    Scroll_Line_Up;
    Scroll_Line_Down;
    Close_Window;
    New_Tab;
    Close_Tab;
    Next_Tab;
    Previous_Tab;
    Split_Horizontal;
    Split_Vertical;
    Close_Pane;
    Next_Pane;
    Previous_Pane;
    Focus_Pane_Left;
    Focus_Pane_Right;
    Focus_Pane_Up;
    Focus_Pane_Down;
}

Binding :: struct #c_call {
    key: s32;
    mods: s32; // Shift=1, Ctrl=2, Alt=4.
    action: s32;
}

Bindings :: struct {
    items: [128]Binding;
    count: s32;
    // Native filtering keeps the three-integer Binding ABI. Profile targets
    // are resolved in Glosso: zero means the action's normal/default profile.
    profile_ids: [128]s32;
}

defaults :: () -> Bindings {
    result: Bindings;
    default_add(&result, 67, 3, .Copy);
    default_add(&result, 86, 3, .Paste);
    default_add(&result, 45, 1, .Paste);
    default_add(&result, 187, 2, .Zoom_In);
    default_add(&result, 187, 3, .Zoom_In);
    default_add(&result, 107, 2, .Zoom_In);
    default_add(&result, 107, 3, .Zoom_In);
    default_add(&result, 189, 2, .Zoom_Out);
    default_add(&result, 189, 3, .Zoom_Out);
    default_add(&result, 109, 2, .Zoom_Out);
    default_add(&result, 109, 3, .Zoom_Out);
    default_add(&result, 48, 2, .Reset_Zoom);
    default_add(&result, 96, 2, .Reset_Zoom);
    default_add(&result, 33, 1, .Scroll_Page_Up);
    default_add(&result, 34, 1, .Scroll_Page_Down);
    default_add(&result, 36, 1, .Scroll_Top);
    default_add(&result, 35, 1, .Scroll_Bottom);
    default_add(&result, 84, 3, .New_Tab);
    default_add(&result, 87, 3, .Close_Tab);
    default_add(&result, 9, 2, .Next_Tab);
    default_add(&result, 9, 3, .Previous_Tab);
    default_add(&result, 79, 3, .Split_Horizontal);
    default_add(&result, 69, 3, .Split_Vertical);
    default_add(&result, 88, 3, .Close_Pane);
    default_add(&result, 34, 4, .Next_Pane);
    default_add(&result, 33, 4, .Previous_Pane);
    default_add(&result, 37, 6, .Focus_Pane_Left);
    default_add(&result, 39, 6, .Focus_Pane_Right);
    default_add(&result, 38, 6, .Focus_Pane_Up);
    default_add(&result, 40, 6, .Focus_Pane_Down);
    return result;
}

action_from_name :: (name: str) -> Action {
    if name == "copy"             return .Copy;
    if name == "paste"            return .Paste;
    if name == "zoom_in"          return .Zoom_In;
    if name == "zoom_out"         return .Zoom_Out;
    if name == "reset_zoom"       return .Reset_Zoom;
    if name == "scroll_page_up"   return .Scroll_Page_Up;
    if name == "scroll_page_down" return .Scroll_Page_Down;
    if name == "scroll_top"       return .Scroll_Top;
    if name == "scroll_bottom"    return .Scroll_Bottom;
    if name == "scroll_line_up"   return .Scroll_Line_Up;
    if name == "scroll_line_down" return .Scroll_Line_Down;
    if name == "close_window"     return .Close_Window;
    if name == "new_tab"          return .New_Tab;
    if name == "close_tab"        return .Close_Tab;
    if name == "next_tab"         return .Next_Tab;
    if name == "previous_tab"     return .Previous_Tab;
    if name == "split_horizontal" return .Split_Horizontal;
    if name == "split_vertical"   return .Split_Vertical;
    if name == "close_pane"       return .Close_Pane;
    if name == "next_pane"        return .Next_Pane;
    if name == "previous_pane"    return .Previous_Pane;
    if name == "focus_pane_left"  return .Focus_Pane_Left;
    if name == "focus_pane_right" return .Focus_Pane_Right;
    if name == "focus_pane_up"    return .Focus_Pane_Up;
    if name == "focus_pane_down"  return .Focus_Pane_Down;
    return .None;
}

action_name :: (action: Action) -> str {
    if action == .Copy             return "copy";
    if action == .Paste            return "paste";
    if action == .Zoom_In          return "zoom_in";
    if action == .Zoom_Out         return "zoom_out";
    if action == .Reset_Zoom       return "reset_zoom";
    if action == .Scroll_Page_Up   return "scroll_page_up";
    if action == .Scroll_Page_Down return "scroll_page_down";
    if action == .Scroll_Top       return "scroll_top";
    if action == .Scroll_Bottom    return "scroll_bottom";
    if action == .Scroll_Line_Up   return "scroll_line_up";
    if action == .Scroll_Line_Down return "scroll_line_down";
    if action == .Close_Window     return "close_window";
    if action == .New_Tab          return "new_tab";
    if action == .Close_Tab        return "close_tab";
    if action == .Next_Tab         return "next_tab";
    if action == .Previous_Tab     return "previous_tab";
    if action == .Split_Horizontal return "split_horizontal";
    if action == .Split_Vertical   return "split_vertical";
    if action == .Close_Pane       return "close_pane";
    if action == .Next_Pane        return "next_pane";
    if action == .Previous_Pane    return "previous_pane";
    if action == .Focus_Pane_Left  return "focus_pane_left";
    if action == .Focus_Pane_Right return "focus_pane_right";
    if action == .Focus_Pane_Up    return "focus_pane_up";
    if action == .Focus_Pane_Down  return "focus_pane_down";
    return "(unknown action)";
}

// The returned view borrows fixed module storage. It survives temporary-arena
// resets and remains valid until the next keybinding parser/validation error.
error_message :: () -> str {
    return binding_error_view(
        cast([*]const u8) &binding_last_error_storage,
        binding_last_error_count
    );
}

clear_action :: (table: *Bindings, action: Action) {
    next: s32 = 0;
    for i: 0..table.count {
        item := table.items[i];
        if item.action != cast(s32) action {
            table.items[next] = item;
            table.profile_ids[next] = table.profile_ids[i];
            next += 1;
        }
    }
    table.count = next;
}

// Conflicts between different actions are checked only by validate(), after
// every Lua override is applied. This permits action swaps in any table order.
add :: (table: *Bindings, chord: str, action: Action) -> bool {
    return add_profile(table, chord, action, 0);
}

add_profile :: (table: *Bindings, chord: str, action: Action, profile_id: s32) -> bool {
    if cast(s32) action <= 0 || cast(s32) action > cast(s32) Action.Focus_Pane_Down
        return binding_error(chord, "unknown action");
    if profile_id < 0 || profile_id > 32 || (profile_id > 0 && !profile_action(action))
        return binding_error(
            chord,
            "profile targets are supported only for new tabs and splits (1..32)"
        );
    if table.count < 0 || table.count >= 128
        return binding_error(chord, "at most 128 configured chords are supported");
    key, mods: s32;
    if !parse(chord, &key, &mods) return false;
    for i: 0..table.count {
        item := table.items[i];
        if item.key == key && item.mods == mods && item.action == cast(s32) action
            return binding_error(chord, "duplicate chord in the same action");
    }
    table.items[table.count] = .{ key, mods, cast(s32) action };
    table.profile_ids[table.count] = profile_id;
    table.count += 1;
    return true;
}

lookup :: (table: *const Bindings, key: s32, mods: s32) -> Action {
    for i: 0..table.count {
        item := table.items[i];
        if item.key == key && item.mods == mods return cast(Action) item.action;
    }
    return .None;
}

profile_for :: (table: *const Bindings, key: s32, mods: s32) -> s32 {
    for i: 0..table.count {
        item := table.items[i];
        if item.key == key && item.mods == mods return table.profile_ids[i];
    }
    return 0;
}

profile_action :: (action: Action) -> bool {
    return action == .New_Tab || action == .Split_Horizontal || action == .Split_Vertical;
}

validate :: (table: *const Bindings) -> bool {
    if table.count < 0 || table.count > 128 return binding_error("(table)", "invalid chord count");
    for i: 0..table.count {
        a := table.items[i];
        if a.key <= 0 || a.key > 255 || a.mods < 0 || a.mods > 7 ||
           a.action <= 0 || a.action > cast(s32) Action.Focus_Pane_Down
            return binding_error("(table)", "invalid chord entry");
        profile_id := table.profile_ids[i];
        if profile_id < 0 || profile_id > 32 ||
           (profile_id > 0 && !profile_action(cast(Action) a.action))
            return binding_error("(table)", "invalid profile target");
        if a.key == 115 && (a.mods & 4) != 0
            return binding_error("Alt+F4", "reserved by Windows for closing the window");
        for j: i + 1..table.count {
            b := table.items[j];
            if a.key == b.key && a.mods == b.mods {
                return binding_error(
                    "(table)",
                    tprint(
                        "conflicting actions '{}' and '{}' both use virtual key {} with modifiers {}",
                        action_name(cast(Action) a.action),
                        action_name(cast(Action) b.action),
                        a.key,
                        a.mods
                    )
                );
            }
        }
    }
    return true;
}

}

default_add :: (table: *Bindings, key: s32, mods: s32, action: Action) {
    table.items[table.count] = .{ key, mods, cast(s32) action };
    table.profile_ids[table.count] = 0;
    table.count += 1;
}

binding_error :: (chord: str, message: str) -> bool {
    visible_chord := chord;
    if visible_chord.count > 128 visible_chord = tprint("{}...", chord[0..128]);
    diagnostic := tprint("keybinding '{}': {}", visible_chord, message);
    count := diagnostic.count;
    if count > 1023 count = 1023;
    for i: 0..count binding_last_error_storage[i] = diagnostic[i];
    binding_last_error_storage[count] = 0;
    binding_last_error_count = count;
    print("wst: {}\n", error_message());
    return false;
}

binding_error_view :: (data: [*]const u8, count: ssize) -> str #magic "string_from_raw_parts";

lower :: (byte: u8) -> u8 {
    if byte >= 65 && byte <= 90 return byte + 32;
    return byte;
}

same_name :: (a: str, b: str) -> bool {
    if a.count != b.count return false;
    for i: 0..a.count if lower(a[i]) != lower(b[i]) return false;
    return true;
}

trim :: (text: str) -> str {
    first: ssize = 0;
    last := text.count;
    while first < last && (text[first] == 32 || text[first] == 9) first += 1;
    while last > first && (text[last - 1] == 32 || text[last - 1] == 9) last -= 1;
    return text[first..last];
}

parse :: (chord: str, key: *s32, mods: *s32) -> bool {
    text := trim(chord);
    if text.count == 0 || text.count > 128
        return binding_error(chord, "a chord of 1..128 ASCII bytes");
    for i: 0..text.count {
        byte := text[i];
        if byte == 0 || byte >= 128 || byte == 10 || byte == 13
            return binding_error(chord, "ASCII key/modifier names without control characters");
    }
    separator: ssize = -1;
    for i: 0..text.count if text[i] == 43 separator = i;
    prefix: str = "";
    name := text;
    literal_plus := false;
    if text == "+" {
        separator = -1;
        literal_plus = true;
        name = "Plus";
    } else if separator == text.count - 1 {
        before := trim(text[0..text.count - 1]);
        if before.count == 0 || before[before.count - 1] != 43
            return binding_error(
                chord,
                "a key after the final '+' (use Equal or Plus for the plus key)"
            );
        literal_plus = true;
        prefix = trim(before[0..before.count - 1]);
        name = "Plus";
    } else if separator >= 0 {
        prefix = text[0..separator];
        name = trim(text[separator + 1..text.count]);
    }
    value: s32 = 0;
    if separator >= 0 && prefix.count == 0
        return binding_error(chord, "a modifier before '+'");
    if prefix.count > 0 {
        begin: ssize = 0;
        while begin <= prefix.count {
            end := begin;
            while end < prefix.count && prefix[end] != 43 end += 1;
            modifier := trim(prefix[begin..end]);
            bit: s32 = 0;
            if same_name(modifier, "Ctrl") || same_name(modifier, "Control")
                bit = 2;
            else if same_name(modifier, "Shift")
                bit = 1;
            else if same_name(modifier, "Alt")
                bit = 4;
            else
                return binding_error(chord, "only Ctrl, Shift and Alt modifiers");
            if (value & bit) != 0 return binding_error(chord, "each modifier at most once");
            value |= bit;
            if end == prefix.count break;
            begin = end + 1;
        }
    }
    code := key_code(name);
    if literal_plus code = 187;
    if code == 0    return binding_error(chord, "a supported key name");
    if code == 115 && (value & 4) != 0
        return binding_error(chord, "Alt+F4 is reserved by Windows for closing the window");
    key.* = code;
    mods.* = value;
    return true;
}

key_code :: (name: str) -> s32 {
    if name.count == 1 {
        b := lower(name[0]);
        if b >= 97 && b <= 122 return cast(s32)(b - 32);
        if b >= 48 && b <= 57  return cast(s32) b;
        if b == 61             return 187;
        if b == 45             return 189;
        if b == 59             return 186;
        if b == 44             return 188;
        if b == 46             return 190;
        if b == 47             return 191;
        if b == 96             return 192;
        if b == 91             return 219;
        if b == 92             return 220;
        if b == 93             return 221;
        if b == 39             return 222;
    }
    if name.count >= 2 && name.count <= 3 && lower(name[0]) == 102 {
        n: s32 = 0;
        if name[1] == 48 return 0;
        for i: 1..name.count {
            if name[i] < 48 || name[i] > 57 return 0;
            n = n * 10 + cast(s32)(name[i] - 48);
        }
        if n >= 1 && n <= 12 return 111 + n;
        return 0;
    }
    if name.count == 4 && same_name(name[0..3], "Num") && name[3] >= 48 && name[3] <= 57
        return 96 + cast(s32)(name[3] - 48);
    if name.count == 7 && same_name(name[0..6], "Numpad") && name[6] >= 48 && name[6] <= 57
        return 96 + cast(s32)(name[6] - 48);
    if same_name(name, "Equal") || same_name(name, "Plus") || same_name(name, "OemPlus") return 187;
    if same_name(name, "Minus") || same_name(name, "OemMinus")                           return 189;
    if same_name(name, "NumAdd") || same_name(name, "NumpadAdd")                         return 107;
    if same_name(name, "NumSubtract") || same_name(name, "NumpadSubtract")               return 109;
    if same_name(name, "NumMultiply") || same_name(name, "NumpadMultiply")               return 106;
    if same_name(name, "NumDivide") || same_name(name, "NumpadDivide")                   return 111;
    if same_name(name, "NumDecimal") || same_name(name, "NumpadDecimal")                 return 110;
    if same_name(name, "Semicolon")                                                      return 186;
    if same_name(name, "Comma")                                                          return 188;
    if same_name(name, "Period")                                                         return 190;
    if same_name(name, "Slash")                                                          return 191;
    if same_name(name, "Backtick")                                                       return 192;
    if same_name(name, "LeftBracket")                                                    return 219;
    if same_name(name, "Backslash")                                                      return 220;
    if same_name(name, "RightBracket")                                                   return 221;
    if same_name(name, "Quote")                                                          return 222;
    if same_name(name, "PageUp") || same_name(name, "PgUp")                              return 33;
    if same_name(name, "PageDown") || same_name(name, "PgDn") || same_name(name, "PgDown")
        return 34;
    if same_name(name, "Home")                               return 36;
    if same_name(name, "End")                                return 35;
    if same_name(name, "Insert") || same_name(name, "Ins")   return 45;
    if same_name(name, "Delete") || same_name(name, "Del")   return 46;
    if same_name(name, "Up")                                 return 38;
    if same_name(name, "Down")                               return 40;
    if same_name(name, "Left")                               return 37;
    if same_name(name, "Right")                              return 39;
    if same_name(name, "Tab")                                return 9;
    if same_name(name, "Enter") || same_name(name, "Return") return 13;
    if same_name(name, "Escape") || same_name(name, "Esc")   return 27;
    if same_name(name, "Backspace")                          return 8;
    if same_name(name, "Space")                              return 32;
    return 0;
}
