//! App-local compatibility for std/Gui's Direct3D swapchain and HWND opacity.
#import "Compiler";
#import "Format";
#import "File_System/Path";
#import "Strings/Utf8";
#import "Io";

bindings :: () -> str {
    source := tprint("{}/gui_presentation.c", path_dirname(#source_location.filename));
    sources: [1]str = .[source];
    if Native_Compile_Output.compile_c_archive(
        "wst_gui_presentation",
        sources[..],
        .compiler_args = .["-std=c11", "-Wall", "-Wextra", "-Werror"],
        .optimization_level = .O3
    ) == {
    case .Ok(built);
        return tprint("presentation :: #library,static \"{}\";", built.artifact.replace("\\", "/"));
    case .Err(error);
        print("Gui presentation compatibility build failed: {}\n", error.message);
        return "#comptime { #compile_error \"could not build Gui presentation compatibility\"; }";
    }
}
#insert #comptime bindings();

#public composed :: (window: usize) -> s32 #foreign presentation "wst_gui_presentation_composed";

/// Borrowed UTF-8 description of the last D3D11 device. The next successful
/// device creation replaces the contents of the process-wide static buffer.
#public adapter_name :: () -> cstr #foreign presentation "wst_gui_adapter_name";
