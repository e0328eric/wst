//! A single-file, debounced config watcher. No directory traversal or thread.
P :: #import "platform.glo";
#import "Strings/Utf8";

#public {

Watch :: struct {
    path: str;
    active: bool;
    last_poll: u64;
    status: s32;
    modified: u64;
    size: u64;
    identity: u64;
    pending: bool;
    changed_at: u64;
}

/// Owns a copy of path. Existing contents establish a baseline without a reload;
/// a missing file is still watched so creating it later can load configuration.
start :: (watch: *Watch, path: str, now: u64) {
    close(watch);
    if path.count == 0 return;
    watch.path = path.clone();
    watch.active = true;
    watch.last_poll = now;
    stamp: P.File_Stamp;
    watch.status = P.file_stamp(path.c_string(), &stamp);
    if watch.status == 1 {
        watch.modified = stamp.modified;
        watch.size = stamp.size;
        watch.identity = stamp.identity;
    }
}

/// Polls metadata at most four times a second. A changed file must be seen
/// unchanged for 250 ms before it is reported, avoiding most partial saves.
/// Removal and temporary sharing/access failures never request an empty config.
poll :: (watch: *Watch, now: u64) -> bool {
    if !watch.active return false;
    if now < watch.last_poll {
        watch.last_poll = now;
        return false;
    }
    if now - watch.last_poll < 250 return false;
    watch.last_poll = now;
    stamp: P.File_Stamp;
    status := P.file_stamp(watch.path.c_string(), &stamp);
    return observe(watch, status, stamp.modified, stamp.size, stamp.identity, now);
}

/// Advance one observation without filesystem IO. Keeping the state transition
/// separate makes debounce, replacement and transient-error behavior testable.
observe :: (watch: *Watch, status: s32, modified: u64, size: u64, identity: u64, now: u64) -> bool {
    if !watch.active return false;
    if status < 0 {
        // A file locked mid-save is not evidence that its contents are stable.
        if watch.pending watch.changed_at = now;
        return false;
    }
    if status == 0 {
        watch.status = 0;
        watch.pending = false;
        return false;
    }
    if watch.status != 1 || watch.modified != modified || watch.size != size || watch.identity != identity {
        watch.status = 1;
        watch.modified = modified;
        watch.size = size;
        watch.identity = identity;
        watch.pending = true;
        watch.changed_at = now;
        return false;
    }
    if watch.pending && now >= watch.changed_at && now - watch.changed_at >= 250 {
        watch.pending = false;
        return true;
    }
    return false;
}

close :: (watch: *Watch) {
    watch.path.free();
    empty: Watch;
    watch.* = empty;
}

}
