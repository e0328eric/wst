//! VT keyboard encoding and clipboard normalization, independent of Win32.
//! Returned strings use the temporary allocator and must be consumed promptly.
#import "Format";
#import "String_Builder";

#public {

// Windows virtual keys; mods: Shift=1, Ctrl=2, Alt=4.
key_sequence :: (key: s32, mods: s32, application: bool) -> str {
    modifier: s32 = 1;
    if (mods & 1) != 0 modifier += 1;
    if (mods & 2) != 0 modifier += 4;
    if (mods & 4) != 0 modifier += 2;

    final: str = "";
    if      key == 38 final = "A";
    else if key == 40 final = "B";
    else if key == 39 final = "C";
    else if key == 37 final = "D";
    else if key == 36 final = "H";
    else if key == 35 final = "F";
    if final.count > 0 {
        if modifier != 1 return tprint("\x1b[1;{}{}", modifier, final);
        if application   return tprint("\x1bO{}", final);
        return tprint("\x1b[{}", final);
    }

    if key >= 112 && key <= 115 {
        if      key == 112 final = "P";
        else if key == 113 final = "Q";
        else if key == 114 final = "R";
        else               final = "S";
        if modifier != 1 return tprint("\x1b[1;{}{}", modifier, final);
        return tprint("\x1bO{}", final);
    }

    number: s32 = 0;
    if      key == 45  number = 2;
    else if key == 46  number = 3;
    else if key == 33  number = 5;
    else if key == 34  number = 6;
    else if key == 116 number = 15;
    else if key == 117 number = 17;
    else if key == 118 number = 18;
    else if key == 119 number = 19;
    else if key == 120 number = 20;
    else if key == 121 number = 21;
    else if key == 122 number = 23;
    else if key == 123 number = 24;
    if number > 0 {
        if modifier != 1 return tprint("\x1b[{};{}~", number, modifier);
        return tprint("\x1b[{}~", number);
    }

    if key == 9 && (mods & 1) != 0 {
        if modifier == 2 return "\x1b[Z";
        return tprint("\x1b[1;{}Z", modifier);
    }
    return "";
}

paste :: (text: str, bracketed: bool) -> str {
    builder := String_Builder.make_len_cap(
        .cap = text.count + 12,
        .allocator = context.temp_allocator,
    );
    if bracketed builder.write_string("\x1b[200~");
    index: ssize = 0;
    while index < text.count {
        byte := text[index];
        // Clipboard data cannot terminate the bracketed paste early.
        if bracketed && byte == 27 {
            index += 1;
            continue;
        }
        if byte == 13 {
            builder.write_byte(13);
            if index + 1 < text.count && text[index + 1] == 10 index += 1;
        } else if byte == 10 builder.write_byte(13);
        else builder.write_byte(byte);
        index += 1;
    }
    if bracketed builder.write_string("\x1b[201~");
    return builder.into_temporary_string();
}

}
