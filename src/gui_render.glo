//! Terminal drawing through the standard Gui renderer. Coordinates at this
//! boundary are physical pixels, matching ConPTY cells and Clay's scaled layout.
G :: #import "Gui";
GN :: #import "Gui/Native";
Types :: #import "platform_types.glo";
Colors :: #import "colors.glo";
S :: #import "windows_shaping.glo";
Glyph_Font :: #import "glyph_font.glo";
#import "Unicode";
Emoji_Render :: #import "emoji_render.glo";
Kitty :: #import "kitty_store.glo";
Terminal :: #import "terminal.glo";
#import "windows_fonts.glo";
#import "Format";
#import "Io";
#import "Math/Core";
#import "Strings/Utf8";
#export "Gui" {
    Window, Font
};
#export "Gui/Native" {
    Native_Rect, Native_Color, Native_Vec2
};
#export "platform_types.glo" {
    Render_Cell
};

bytes_view :: (data: [*]const u8, count: ssize) -> []const u8 #magic "slice_from_pointer";
kernel32 :: #library,system "kernel32";
GetLastError :: () -> u32 #foreign kernel32;

// Glosso can evaluate a read of an initially empty global during #assert.
// Keep public renderer state queries tied to the running application.
runtime_only :: () #inline,always {
    _ := GetLastError();
}

#public Command_Kind :: enum { Rectangle; Glyph; Label; Rounded_Rect; Stroke; Image; Powerline; Color_Emoji; }
#public Command :: struct {
    kind: Command_Kind;
    x: s32;
    y: s32;
    width: s32;
    height: s32;
    color: u32;
    cp: u32;
    font: G.Font;
    text: str;
    clipped: bool;
    clip: GN.Native_Rect;
    double_ink: bool;
    geometry: f32;
    offset_x: f32;
    offset_y: f32;
    image_index: ssize;
}

// Snapshots replay immutable GPU textures. The parser can release or replace
// the source pixels as soon as the grid has been drawn.
#public Image_Command :: struct {
    texture: G.Texture;
    destination: GN.Native_Rect;
    source: GN.Native_Rect;
    clip: GN.Native_Rect;
}
#public Image_Texture :: struct {
    token: u64;
    texture: G.Texture;
    context_id: s32;
    in_frame: bool;
}

// Bounded, direct-mapped cache. Entries own their source and shaping buffers;
// replay commands contain only glyph IDs and positions, never borrowed runs.
#public Shape_Cache :: struct {
    text: str;
    bold: bool;
    valid: bool;
    run: S.Run;
}

default_state: Window_State;
selected_state: ?*Window_State;

state :: () -> *Window_State #inline,always {
    if #pattern ?selected = selected_state return selected;
    return &default_state;
}

#public {

Window_State :: struct {
    window: G.Window;
    current: Prepared;
    active: bool;
    focused: bool = true;
    ligatures: bool = true;
    selected_fg: u32 = 16#ffffff;
    selected_bg: u32 = 16#3b506e;
    cursor_ink: u32 = 16#11151c;
    current_context: s32;
    replaying: bool;
    error_storage: [1024]u8;
    error_count: ssize;
    commands: [..]Command;
    image_commands: [..]Image_Command;
    image_textures: [..]Image_Texture;
    shape_cache: [256]Shape_Cache;
    emoji: Emoji_Render.Window_State;
}

select_state :: (value: ?*Window_State) {
    selected_state = value;
    if #pattern ?selected = value Emoji_Render.select_state(?&selected.emoji);
    else                           Emoji_Render.select_state(null);
}

Font_Face :: struct {
    face: usize;
    // A cell repaint usually asks about the same handful of codepoints.
    checked: [128]u32;
}
Fallback_Chain :: struct {
    fonts: [3]G.Font;
    faces: [3]usize;
    attempted: s32;
    tail: G.Font;
}

Prepared :: struct {
    changed: bool;
    family: str;
    size: s32;
    scale: f32;
    cw: s32;
    ch: s32;
    regular: G.Font;
    bold: G.Font;
    ui: G.Font;
    ui_small: G.Font;
    bold_simulated: bool;
    regular_glyphs: G.Font;
    bold_glyphs: G.Font;
    regular_shaper: S.Shaper;
    bold_shaper: S.Shaper;
    regular_glyphs_tried: bool;
    bold_glyphs_tried: bool;
    regular_face: Font_Face;
    bold_face: Font_Face;
    ui_face: Font_Face;
    small_face: Font_Face;
    // Terminal, 16-DIP label, and 13-DIP chrome fallbacks are loaded on demand.
    fallback: [3]Fallback_Chain;
}

bind_window :: (value: G.Window) {
    state().window = value;
}
frame_active :: () -> bool {
    runtime_only();
    return state().active;
}
font_family :: () -> str {
    runtime_only();
    return state().current.family;
}
font_size :: () -> s32 {
    runtime_only();
    return state().current.size;
}
font_scale :: () -> f32 {
    runtime_only();
    return state().current.scale;
}
ligatures_enabled :: () -> bool {
    runtime_only();
    return state().ligatures;
}
set_ligatures :: (value: bool) {
    live := state();
    if live.ligatures == value return;
    live.ligatures = value;
    invalidate_frame();
}
error_message :: () -> str {
    live := state();
    return cast(str) bytes_view(cast([*]const u8) &live.error_storage, live.error_count);
}

prepare :: (family: str, size: s32, scale: f32, result: *Prepared) -> bool {
    live := state();
    discard(result);
    remember("");
    if family.count == 0 || !family.string_is_valid() || size < 8 || size > 72 || scale <= 0 || scale > 8 {
        remember("Invalid font family, size, or display scale");
        return false;
    }
    if live.current.family == family && live.current.size == size && live.current.scale == scale && G.font_valid(
        live.current.regular
    ) {
        result.cw = live.current.cw;
        result.ch = live.current.ch;
        return true;
    }
    next: Prepared;
    next.changed = true;
    next.family = family.clone();
    next.size = size;
    next.scale = scale;
    metrics: Font_Data;
    next.regular = load_face(family, size, scale, 0, &metrics, 0, &next.regular_face.face);
    if !G.font_valid(next.regular) {
        discard(&next);
        return false;
    }
    next.cw = positive_ceil(G.glyph_advance(next.regular, #char "M") * scale);
    line_units := metrics.ascent + metrics.descent + metrics.line_gap;
    if line_units < metrics.ascent + metrics.descent line_units = metrics.ascent + metrics.descent;
    next.ch = positive_ceil(cast(f32) size * cast(f32) line_units / cast(f32) metrics.units * scale);
    next.bold = load_face(family, size, scale, 1, &metrics, 0, &next.bold_face.face);
    next.bold_simulated = metrics.simulated_bold != 0;
    if !G.font_valid(next.bold) {
        discard(&next);
        return false;
    }
    next.ui = load_face("Segoe UI", 16, scale, 0, &metrics, 0, &next.ui_face.face);
    if !G.font_valid(next.ui) {
        discard(&next);
        return false;
    }
    next.ui_small = load_face("Segoe UI", 13, scale, 0, &metrics, 0, &next.small_face.face);
    if !G.font_valid(next.ui_small) {
        discard(&next);
        return false;
    }
    _ := S.open(next.regular_face.face, &next.regular_shaper);
    _ := S.open(next.bold_face.face, &next.bold_shaper);
    result.* = next;
    return true;
}

commit :: (prepared: *Prepared) {
    live := state();
    if !prepared.changed return;
    Emoji_Render.clear();
    clear_shape_cache();
    discard(&live.current);
    live.current = prepared.*;
    empty: Prepared;
    prepared.* = empty;
    invalidate_frame();
}

discard :: (prepared: *Prepared) {
    S.close(&prepared.regular_shaper);
    S.close(&prepared.bold_shaper);
    G.release_font(prepared.regular_glyphs);
    G.release_font(prepared.bold_glyphs);
    G.release_font(prepared.regular);
    G.release_font(prepared.bold);
    G.release_font(prepared.ui);
    G.release_font(prepared.ui_small);
    native_release_face(prepared.regular_face.face);
    native_release_face(prepared.bold_face.face);
    native_release_face(prepared.ui_face.face);
    native_release_face(prepared.small_face.face);
    for chain: prepared.fallback for i: 0..chain.attempted {
        G.release_font(chain.fonts[i]);
        native_release_face(chain.faces[i]);
    }
    prepared.family.free();
    empty: Prepared;
    prepared.* = empty;
}

metrics :: (cw: *s32, ch: *s32) {
    live := state();
    cw.* = live.current.cw;
    ch.* = live.current.ch;
}
set_focus :: (value: bool) {
    state().focused = value;
}
set_colors :: (selection_fg: u32, selection_bg: u32, cursor_text: u32) {
    live := state();
    live.selected_fg = selection_fg;
    live.selected_bg = selection_bg;
    live.cursor_ink = cursor_text;
}

invalidate_frame :: () {
    clear_commands();
}
grid_context :: (id: s32) -> s32 {
    if id < 0 || id > 32 {
        remember("Invalid terminal render context");
        return 0;
    }
    state().current_context = id;
    return 1;
}
forget_context :: (id: s32) {
    live := state();
    has_images := false;
    i := live.image_textures.count;
    while i > 0 {
        i -= 1;
        if live.image_textures[i].context_id == id {
            G.release_texture(live.image_textures.swap_remove(i).texture);
            has_images = true;
        }
    }
    if id == live.current_context || has_images invalidate_frame();
}

frame_begin :: (color: u32) -> bool {
    live := state();
    if !live.active {
        if !G.begin_render_frame(live.window) {
            remember(G.last_error());
            return false;
        }
        live.active = true;
    }
    clear_commands();
    for i: 0..live.image_textures.count live.image_textures[i].in_frame = false;
    dimensions := G.render_dimensions(live.window);
    rect(0, 0, cast(s32) dimensions.x, cast(s32) dimensions.y, color);
    return true;
}

frame_end :: () {
    live := state();
    if !live.active return;
    G.present_frame(live.window);
    live.active = false;
    _ := discard_unused_textures();
}

close :: () {
    live := state();
    frame_end();
    clear_commands();
    live.commands.reset();
    live.image_commands.reset();
    for entry: live.image_textures G.release_texture(entry.texture);
    live.image_textures.reset();
    Emoji_Render.close();
    clear_shape_cache();
    discard(&live.current);
    live.ligatures = true;
    empty: G.Window;
    live.window = empty;
    live.current_context = 0;
}

rect :: (x: s32, y: s32, width: s32, height: s32, color: u32) {
    if !state().active || width <= 0 || height <= 0 return;
    emit(.{ .kind = .Rectangle, .x = x, .y = y, .width = width, .height = height, .color = color });
}

rounded_rect :: (x: s32, y: s32, width: s32, height: s32, radius: s32, color: u32) {
    if !state().active || width <= 0 || height <= 0 return;
    if radius <= 0 {
        rect(x, y, width, height, color);
        return;
    }
    emit(
        .{
            .kind = .Rounded_Rect,
            .x = x,
            .y = y,
            .width = width,
            .height = height,
            .geometry = cast(f32) radius,
            .color = color
        }
    );
}

line :: (x1: s32, y1: s32, x2: s32, y2: s32, thickness: f32, color: u32) {
    if !state().active || !is_finite(thickness) || thickness <= 0 || thickness > 4096 return;
    emit(
        .{
            .kind = .Stroke,
            .x = x1,
            .y = y1,
            .width = x2,
            .height = y2,
            .geometry = thickness,
            .color = color
        }
    );
}

draw_label :: (x: s32, y: s32, width: s32, height: s32, text: str, color: u32) {
    label_with_font(state().current.ui, x, y, width, height, text, color, false);
}

/// Compact proportional chrome text stays at 13 DIP when the terminal zooms.
draw_ui_label :: (x: s32, y: s32, width: s32, height: s32, text: str, color: u32) {
    label_with_font(state().current.ui_small, x, y, width, height, text, color, true);
}

measure_ui :: (text: str) -> s32 {
    live := state();
    if text.count == 0 return 0;
    ensure_text_fonts(live.current.ui_small, text);
    return positive_ceil(G.measure_text(live.current.ui_small, text) * live.current.scale);
}

}

label_with_font :: (
    font: G.Font,
    x: s32,
    y: s32,
    width: s32,
    height: s32,
    text: str,
    color: u32,
    chrome: bool
) {
    live := state();
    if !live.active || width <= 0 || height <= 0 return;
    ensure_text_fonts(font, text);
    shown: str;
    if chrome shown = fit_ui_label(text, width);
    else      shown = fit_label(font, text, width);
    logical_height := G.font_height(font) * live.current.scale;
    top := y + (height - cast(s32) logical_height) / 2;
    emit(
        .{
            .kind = .Label,
            .x = x,
            .y = top,
            .width = width,
            .height = height,
            .color = color,
            .font = font,
            .text = shown.clone(),
            .clipped = true,
            .clip = .{ cast(f32) x, cast(f32) y, cast(f32) width, cast(f32) height }
        }
    );
}

#public {

cell :: (
    x: s32,
    y: s32,
    width: s32,
    height: s32,
    cp: u32,
    fg: u32,
    bg: u32,
    flags: u32,
    is_selected: s32
) {
    draw_cell(x, y, width, height, cp, fg, bg, flags, is_selected != 0, false, .{});
}

cursor :: (x: s32, y: s32, width: s32, height: s32, color: u32) {
    if state().focused rect(x, y, width, height, color);
    else {
        rect(x, y, width, 1, color);
        rect(x, y + height - 1, width, 1, color);
        rect(x, y, 1, height, color);
        rect(x + width - 1, y, 1, height, color);
    }
}

grid :: (
    x: s32,
    y: s32,
    cols: s32,
    rows: s32,
    cw: s32,
    ch: s32,
    cells: [*]const Types.Render_Cell,
    cursor_x: s32,
    cursor_y: s32,
    visible: s32,
    color: u32
) {
    draw_grid(x, y, cols, rows, cw, ch, cells, cursor_x, cursor_y, visible, color, false, .{});
}
grid_clipped :: (
    x: s32,
    y: s32,
    cols: s32,
    rows: s32,
    cw: s32,
    ch: s32,
    cells: [*]const Types.Render_Cell,
    cursor_x: s32,
    cursor_y: s32,
    visible: s32,
    color: u32,
    width: s32,
    height: s32,
    graphics: ?*Kitty.Store = null,
    view_offset: s32 = 0
) {
    draw_grid(
        x,
        y,
        cols,
        rows,
        cw,
        ch,
        cells,
        cursor_x,
        cursor_y,
        visible,
        color,
        true,
        .{ cast(f32) x, cast(f32) y, cast(f32) positive(width), cast(f32) positive(height) },
        graphics,
        view_offset
    );
}

/// The facade ensures a readable input frame before calling this when inactive.
snapshot :: (path: str) -> s32 {
    live := state();
    opened := false;
    if !live.active {
        if !G.begin_render_frame(live.window) {
            remember(G.last_error());
            return 0;
        }
        live.active = true;
        opened = true;
        live.replaying = true;
        for command: live.commands draw(command);
        live.replaying = false;
    }
    bitmap := path.count >= 4 && (
        path[path.count - 4..path.count] == ".bmp" || path[path.count - 4..path.count] == ".BMP"
    );
    success := false;
    if bitmap {
        png := tprint("{}.gui.png", path);
        if G.save_frame(live.window, png) {
            success = native_bmp(png, path) != 0;
            if !success remember(native_error().to_string());
        } else remember(G.last_error());
    } else success = G.save_frame(live.window, path);
    if opened              frame_end();
    if !success && !bitmap remember(G.last_error());
    if success             return 1;
    return 0;
}

}

positive :: (value: s32) -> s32 {
    if value < 0 return 0;
    return value;
}
positive_ceil :: (value: f32) -> s32 {
    result := cast(s32) value;
    if cast(f32) result < value result += 1;
    if result < 1               result = 1;
    return result;
}
remember :: (message: str) {
    live := state();
    live.error_count = message.count;
    if live.error_count > 1023 live.error_count = 1023;
    for i: 0..live.error_count live.error_storage[i] = message[i];
}
load_face :: (
    family: str,
    size: s32,
    scale: f32,
    bold: s32,
    metrics: *Font_Data,
    width_limit: s32 = 0,
    face_result: ?*usize = null
) -> G.Font {
    data: Font_Data;
    face: usize;
    if native_font(family, bold, &data, &face) == 0 {
        remember(native_error().to_string());
        return .{};
    }
    defer native_release_face(face);
    defer native_free(&data);
    if family == "Segoe UI Emoji" include_vertical_ink(&data);
    metrics.* = data;
    metrics.bytes = 0;
    if data.units <= 0 {
        remember("Installed font has invalid metrics");
        return .{};
    }
    height := cast(f32) size * cast(f32)(data.ascent + data.descent) / cast(f32) data.units;
    font := G.font_from_bytes(bytes_view(data.data, cast(ssize) data.bytes), height, scale);
    if G.font_valid(font) && width_limit > 0 {
        // Emoji faces can use wider advances than a terminal's two-cell span.
        // Keep the complete fallback glyph inside that span rather than clipping.
        advance := G.glyph_advance(font, #char "😀") * scale;
        if advance > cast(f32) width_limit {
            G.release_font(font);
            font = G.font_from_bytes(
                bytes_view(data.data, cast(ssize) data.bytes),
                height * cast(f32) width_limit / advance,
                scale
            );
        }
    }
    if !G.font_valid(font) remember("Gui could not load the installed font data");
    else if #pattern ?target = face_result {
        native_retain_face(face);
        target.* = face;
    }
    return font;
}

ensure_glyph_font :: (font: G.Font, cp: u32) {
    live := state();
    if font.id == 0 return;
    face := &live.current.regular_face;
    group: s32;
    size := live.current.size;
    if font.id == live.current.bold.id face = &live.current.bold_face;
    else if font.id == live.current.ui.id {
        face = &live.current.ui_face;
        size = 16;
        if live.current.size != 16 group = 1;
    } else if font.id == live.current.ui_small.id {
        face = &live.current.small_face;
        size = 13;
        group = 2;
    }
    chain := &live.current.fallback[group];
    slot := cp % 128;
    if face.checked[slot] == cp || chain.attempted == 3 return;
    face.checked[slot] = cp;
    if native_has_glyph(face.face, cp) return;
    for i: 0..chain.attempted if native_has_glyph(chain.faces[i], cp) return;
    names: [3]str = .["Malgun Gothic", "Yu Gothic", "Segoe UI Emoji"];
    while chain.attempted < 3 {
        i := chain.attempted;
        chain.attempted += 1;
        width_limit: s32;
        if group == 0 && i == 2 width_limit = 2 * live.current.cw;
        metrics: Font_Data;
        fallback := load_face(
            names[i],
            size,
            live.current.scale,
            0,
            &metrics,
            width_limit,
            &chain.faces[i]
        );
        if !G.font_valid(fallback) continue;
        chain.fonts[i] = fallback;
        if G.font_valid(chain.tail) _ := G.set_font_fallback(chain.tail, fallback);
        else if group == 0 {
            _ := G.set_font_fallback(live.current.regular, fallback);
            _ := G.set_font_fallback(live.current.bold, fallback);
            if live.current.size == 16 _ := G.set_font_fallback(live.current.ui, fallback);
        } else _ := G.set_font_fallback(font, fallback);
        chain.tail = fallback;
        if native_has_glyph(chain.faces[i], cp) return;
    }
}

ensure_text_fonts :: (font: G.Font, text: str) {
    offset: ssize;
    while offset < text.count {
        cp := text.rune_at(offset).unwrap_or(#char "�");
        ensure_glyph_font(font, cast(u32) cp);
        offset += 1;
        while offset < text.count && (text[offset] & 16#c0) == 16#80 offset += 1;
    }
}
clear_commands :: () {
    live := state();
    for i: 0..live.commands.count live.commands[i].text.free();
    live.commands.clear();
    live.image_commands.clear();
}
color :: (rgb: u32) -> GN.Native_Color {
    return .{
        cast(f32)((rgb >> 16) & 255) / 255.0,
        cast(f32)((rgb >> 8) & 255) / 255.0,
        cast(f32)(rgb & 255) / 255.0,
        1
    };
}
logical_rect :: (bounds: GN.Native_Rect) -> GN.Native_Rect {
    scale := state().current.scale;
    if scale <= 0 scale = 1;
    return .{ bounds.x / scale, bounds.y / scale, bounds.width / scale, bounds.height / scale };
}
emit :: (command: Command) {
    live := state();
    if !live.active return;
    draw(command);
    if !live.replaying live.commands.push(command);
}
draw :: (command: Command) {
    live := state();
    scale := live.current.scale;
    if scale <= 0 scale = 1;
    if command.clipped G.set_clip(logical_rect(command.clip));
    else               G.reset_clip();
    if command.kind == .Rectangle {
        G.rectangle(
            .{
                cast(f32) command.x / scale,
                cast(f32) command.y / scale,
                cast(f32) command.width / scale,
                cast(f32) command.height / scale
            },
            color(command.color)
        );
    } else if command.kind == .Glyph || command.kind == .Color_Emoji {
        top := command.y;
        if command.kind == .Color_Emoji {
            if Emoji_Render.draw(
                command.cp, command.color, command.x, top, command.width, command.height,
                2 * live.current.cw, live.current.ch, scale
            ) {
                G.reset_clip();
                return;
            }
            ensure_glyph_font(command.font, command.cp);
            top += (command.height - cast(s32)(G.font_height(command.font) * scale)) / 2;
        }
        storage: [4]u8;
        length := encode(command.cp, &storage);
        value := cast(str) bytes_view(cast([*]const u8) &storage, length);
        G.text(
            command.font,
            value,
            .{
                (cast(f32) command.x + command.offset_x) / scale,
                (cast(f32) top + command.offset_y) / scale
            },
            color(command.color)
        );
        if command.double_ink
            G.text(
                command.font,
                value,
                .{
                    (cast(f32) command.x + command.offset_x + 0.6) / scale,
                    (cast(f32) top + command.offset_y) / scale
                },
                color(command.color)
            );
    } else if command.kind == .Label {
        G.text(
            command.font,
            command.text,
            .{ cast(f32) command.x / scale, cast(f32) command.y / scale },
            color(command.color)
        );
    } else if command.kind == .Rounded_Rect {
        draw_rounded(command);
    } else if command.kind == .Stroke {
        draw_stroke(command);
    } else if command.kind == .Powerline {
        draw_powerline(command);
    } else if command.kind == .Image {
        placement := live.image_commands[command.image_index];
        G.set_clip(logical_rect(placement.clip));
        if !G.draw_texture(placement.texture, logical_rect(placement.destination), placement.source)
            remember(G.last_error());
    }
    G.reset_clip();
}

// Gui has a rectangle overlay primitive. These small vector shapes use physical
// pixel coverage for smooth edges, then submit through that same Gui renderer.
paint_rect :: (x: f32, y: f32, width: f32, height: f32, ink: GN.Native_Color) {
    if width <= 0 || height <= 0 || ink.a <= 0 return;
    scale := state().current.scale;
    if scale <= 0 scale = 1;
    G.rectangle(.{ x / scale, y / scale, width / scale, height / scale }, ink);
}
paint_span :: (left: f32, right: f32, y: s32, ink: GN.Native_Color) {
    if right <= left return;
    first := cast(s32) floor(left);
    last := cast(s32) floor(right);
    if first == last {
        pixel := ink;
        pixel.a *= right - left;
        paint_rect(cast(f32) first, cast(f32) y, 1, 1, pixel);
        return;
    }
    edge := ink;
    edge.a *= 1 - (left - cast(f32) first);
    paint_rect(cast(f32) first, cast(f32) y, 1, 1, edge);
    paint_rect(cast(f32)(first + 1), cast(f32) y, cast(f32)(last - first - 1), 1, ink);
    edge = ink;
    edge.a *= right - cast(f32) last;
    paint_rect(cast(f32) last, cast(f32) y, 1, 1, edge);
}
// Solid Powerline separators meet the neighboring segment along the full cell
// edge, including any line gap above and below the font's glyph box.
draw_powerline :: (command: Command) {
    ink := color(command.color);
    left := cast(f32) command.x;
    right := cast(f32)(command.x + command.width);
    for row: cast(s32) 0..command.height {
        from_edge := row;
        if command.height - row - 1 < from_edge from_edge = command.height - row - 1;
        extent := cast(f32)(2 * from_edge + 1) * cast(f32) command.width / cast(f32) command.height;
        if command.cp == 16#e0b0 paint_span(left, left + extent, command.y + row, ink);
        else                     paint_span(right - extent, right, command.y + row, ink);
    }
}
draw_rounded :: (command: Command) {
    radius := cast(s32) command.geometry;
    if radius > command.width / 2  radius = command.width / 2;
    if radius > command.height / 2 radius = command.height / 2;
    ink := color(command.color);
    if radius <= 0 {
        paint_rect(
            cast(f32) command.x,
            cast(f32) command.y,
            cast(f32) command.width,
            cast(f32) command.height,
            ink
        );
        return;
    }
    paint_rect(
        cast(f32) command.x,
        cast(f32)(command.y + radius),
        cast(f32) command.width,
        cast(f32)(command.height - 2 * radius),
        ink
    );
    r := cast(f32) radius;
    for row: cast(s32) 0..radius {
        vertical := r - cast(f32) row - 0.5;
        inset := r - sqrt(r * r - vertical * vertical);
        left := cast(f32) command.x + inset;
        right := cast(f32)(command.x + command.width) - inset;
        paint_span(left, right, command.y + row, ink);
        paint_span(left, right, command.y + command.height - 1 - row, ink);
    }
}
draw_stroke :: (command: Command) {
    ax := cast(f32) command.x;
    ay := cast(f32) command.y;
    bx := cast(f32) command.width;
    by := cast(f32) command.height;
    dx := bx - ax;
    dy := by - ay;
    length_squared := dx * dx + dy * dy;
    radius := command.geometry * 0.5;
    reach := radius + 0.5;
    vertical_length := dy;
    if vertical_length < 0 vertical_length = -vertical_length;
    diagonal_extent: f32;
    if vertical_length > 0 diagonal_extent = reach * sqrt(length_squared) / vertical_length;
    min_x := ax;
    max_x := bx;
    if bx < ax {
        min_x = bx;
        max_x = ax;
    }
    min_y := ay;
    max_y := by;
    if by < ay {
        min_y = by;
        max_y = ay;
    }
    start_x := cast(s32) floor(min_x - reach);
    end_x := cast(s32) ceil(max_x + reach);
    start_y := cast(s32) floor(min_y - reach);
    end_y := cast(s32) ceil(max_y + reach);
    ink := color(command.color);
    for y: start_y..end_y {
        first := start_x;
        last := end_x;
        // Follow a thin band around diagonals instead of scanning their full box.
        if dy != 0 && length_squared > 0 {
            position := (cast(f32) y + 0.5 - ay) / dy;
            if position < 0 position = 0;
            if position > 1 position = 1;
            middle := ax + dx * position;
            band_first := cast(s32) floor(middle - diagonal_extent);
            band_last := cast(s32) ceil(middle + diagonal_extent);
            if band_first > first first = band_first;
            if band_last < last   last = band_last;
        }
        for x: first..last {
            px := cast(f32) x + 0.5;
            py := cast(f32) y + 0.5;
            position: f32;
            if length_squared > 0 position = ((px - ax) * dx + (py - ay) * dy) / length_squared;
            if position < 0       position = 0;
            if position > 1       position = 1;
            distance_x := px - (ax + dx * position);
            distance_y := py - (ay + dy * position);
            coverage := reach - sqrt(distance_x * distance_x + distance_y * distance_y);
            if coverage > 1 coverage = 1;
            if coverage > 0 {
                pixel := ink;
                pixel.a = coverage;
                paint_rect(cast(f32) x, cast(f32) y, 1, 1, pixel);
            }
        }
    }
}
encode :: (value: u32, storage: *[4]u8) -> ssize {
    cp := value;
    if cp > 16#10ffff || (cp >= 16#d800 && cp <= 16#dfff) cp = 16#fffd;
    if cp < 128 {
        storage.*[0] = cast(u8) cp;
        return 1;
    }
    if cp < 2048 {
        storage.*[0] = cast(u8)(192 | (cp >> 6));
        storage.*[1] = cast(u8)(128 | (cp & 63));
        return 2;
    }
    if cp < 65536 {
        storage.*[0] = cast(u8)(224 | (cp >> 12));
        storage.*[1] = cast(u8)(128 | ((cp >> 6) & 63));
        storage.*[2] = cast(u8)(128 | (cp & 63));
        return 3;
    }
    storage.*[0] = cast(u8)(240 | (cp >> 18));
    storage.*[1] = cast(u8)(128 | ((cp >> 12) & 63));
    storage.*[2] = cast(u8)(128 | ((cp >> 6) & 63));
    storage.*[3] = cast(u8)(128 | (cp & 63));
    return 4;
}
intersect :: (a: GN.Native_Rect, b: GN.Native_Rect) -> GN.Native_Rect {
    x := a.x;
    if b.x > x x = b.x;
    y := a.y;
    if b.y > y y = b.y;
    right := a.x + a.width;
    if b.x + b.width < right right = b.x + b.width;
    bottom := a.y + a.height;
    if b.y + b.height < bottom bottom = b.y + b.height;
    width := right - x;
    if width < 0 width = 0;
    height := bottom - y;
    if height < 0 height = 0;
    return .{ x, y, width, height };
}
underline_ink :: (underline: u32, foreground: u32) -> u32 {
    if underline == Colors.UNDERLINE_DEFAULT return foreground;
    return underline;
}

draw_cell :: (
    x: s32,
    y: s32,
    width: s32,
    height: s32,
    cp: u32,
    foreground: u32,
    back: u32,
    flags: u32,
    is_selected: bool,
    clipped: bool,
    clip: GN.Native_Rect,
    paint_background: bool = true,
    underline_color: u32 = Colors.UNDERLINE_DEFAULT
) {
    live := state();
    if !live.active || width <= 0 || height <= 0 return;
    fg := foreground;
    bg := back;
    if (flags & 4) != 0 {
        fg = back;
        bg = foreground;
    }
    if is_selected {
        fg = live.selected_fg;
        bg = live.selected_bg;
    }
    bounds: GN.Native_Rect = .{ cast(f32) x, cast(f32) y, cast(f32) width, cast(f32) height };
    if clipped {
        bounds = intersect(bounds, clip);
        if bounds.width <= 0 || bounds.height <= 0 return;
    }
    if paint_background
        emit(
            .{
                .kind = .Rectangle,
                .x = x,
                .y = y,
                .width = width,
                .height = height,
                .color = bg,
                .clipped = clipped,
                .clip = clip
            }
        );
    if (cp == 16#e0b0 || cp == 16#e0b2) && (flags & 16) == 0 {
        emit(
            .{
                .kind = .Powerline,
                .x = x,
                .y = y,
                .width = width,
                .height = height,
                .color = fg,
                .cp = cp,
                .clipped = true,
                .clip = bounds
            }
        );
    } else if cp != 0 && cp != 32 && (flags & 16) == 0 {
        font := live.current.regular;
        if (flags & 1) != 0 font = live.current.bold;
        kind: Command_Kind = .Glyph;
        top := y;
        if (flags & Terminal.CELL_EMOJI_STYLE) != 0 ||
           ((flags & Terminal.CELL_TEXT_STYLE) == 0 && cp >= 128 && cp.is_unicode_emoji_presentation()) {
            kind = .Color_Emoji;
        } else {
            ensure_glyph_font(font, cp);
            top += (height - cast(s32)(G.font_height(font) * live.current.scale)) / 2;
        }
        emit(
            .{
                .kind = kind,
                .x = x,
                .y = top,
                .width = width,
                .height = height,
                .color = fg,
                .cp = cp,
                .font = font,
                .clipped = true,
                .clip = bounds,
                .double_ink = (flags & 1) != 0 && live.current.bold_simulated
            }
        );
    }
    if (flags & 2) != 0
        emit(
            .{
                .kind = .Rectangle,
                .x = x,
                .y = y + height - 2,
                .width = width,
                .height = 1,
                .color = underline_ink(underline_color, fg),
                .clipped = clipped,
                .clip = clip
            }
        );
}

clear_shape_cache :: () {
    live := state();
    for i: 0..256 {
        live.shape_cache[i].text.free();
        S.free_run(&live.shape_cache[i].run);
        empty: Shape_Cache;
        live.shape_cache[i] = empty;
    }
}

cached_shape :: (text: str, bold: bool) -> *S.Run {
    live := state();
    // Mask an unsigned hash so the slot is 0..255 by construction. The -O3
    // build turned the former signed `% 256` into slot -13, writing a cache
    // entry over neighbouring renderer globals and corrupting the heap.
    hash: u32;
    if bold hash = 1;
    for i: 0..text.count hash = (hash * 33 + cast(u32) text[i]) & 255;
    entry := &live.shape_cache[hash];
    if !entry.valid || entry.text != text || entry.bold != bold {
        entry.text.free();
        entry.text = text.clone();
        entry.bold = bold;
        entry.valid = true;
        shaper := &live.current.regular_shaper;
        if bold shaper = &live.current.bold_shaper;
        _ := S.shape(shaper, text, cast(f32) live.current.size, &entry.run);
    }
    return &entry.run;
}

shapeable :: (cell: Types.Render_Cell) -> bool {
    return cell.codepoint >= 32 && cell.codepoint <= 126 &&
        (cell.flags & (24 | Terminal.CELL_EMOJI_STYLE)) == 0;
}
same_shape_style :: (a: Types.Render_Cell, b: Types.Render_Cell) -> bool {
    // Palette provenance and selection do not alter OpenType substitutions.
    return a.fg == b.fg && a.bg == b.bg && (a.flags & 7) == (b.flags & 7);
}

cluster_end :: (run: *S.Run, first: ssize) -> ssize {
    end := first + 1;
    while end < run.clusters.count && run.clusters[end] == run.clusters[first] end += 1;
    return end;
}
glyph_end :: (run: *S.Run, end: ssize) -> ssize {
    if end < run.clusters.count return cast(ssize) run.clusters[end];
    return run.glyphs.count;
}
substituted_cluster :: (run: *S.Run, first: ssize, end: ssize) -> bool {
    start := cast(ssize) run.clusters[first];
    if glyph_end(run, end) - start != end - first return true;
    for i: first..end if run.glyphs[start + i - first] != run.nominal_glyphs[i] return true;
    return false;
}

// Anchor normal clusters to their source cells so advances never drift across
// a row. Adjacent substituted clusters form one group: contextual ligatures may
// contain several connected glyphs, whose natural spacing must stay intact.
// Clip whole shaped ink, including glyphs extending into earlier source cells.
shaped_ink :: (
    run: *S.Run,
    font: G.Font,
    x: s32,
    y: s32,
    cw: s32,
    ch: s32,
    fg: u32,
    bold: bool,
    clip: GN.Native_Rect
) {
    live := state();
    if clip.width <= 0 || clip.height <= 0 return;
    top := y + (ch - cast(s32)(G.font_height(font) * live.current.scale)) / 2;
    first: ssize;
    while first < run.clusters.count {
        end := cluster_end(run, first);
        if substituted_cluster(run, first, end) {
            while end < run.clusters.count {
                next := cluster_end(run, end);
                if !substituted_cluster(run, end, next) break;
                end = next;
            }
        }
        start_glyph := cast(ssize) run.clusters[first];
        end_glyph := glyph_end(run, end);
        origin := cast(f32)(first * cast(ssize) cw);
        if end - first > 1 {
            width: f32;
            for i: start_glyph..end_glyph width += run.advances[i] * live.current.scale;
            origin += (cast(f32)((end - first) * cast(ssize) cw) - width) * 0.5;
        }
        for i: start_glyph..end_glyph {
            emit(
                .{
                    .kind = .Glyph,
                    .x = x,
                    .y = top,
                    .color = fg,
                    .font = font,
                    .cp = Glyph_Font.GLYPH_BASE + cast(u32) run.glyphs[i],
                    .offset_x = origin + run.offsets[i].advance * live.current.scale,
                    .offset_y = -run.offsets[i].ascender * live.current.scale,
                    .clipped = true,
                    .clip = clip,
                    .double_ink = bold && live.current.bold_simulated
                }
            );
            origin += run.advances[i] * live.current.scale;
        }
        first = end;
    }
}

draw_shaped :: (
    x: s32,
    y: s32,
    count: s32,
    cw: s32,
    ch: s32,
    cells: [*]const Types.Render_Cell,
    cursor_column: s32,
    cursor_color: u32,
    clipped: bool,
    clip: GN.Native_Rect
) -> bool {
    live := state();
    bold := (cells[0].flags & 1) != 0;
    if !live.ligatures || count < 2 return false;
    storage: [512]u8;
    for i: 0..count storage[i] = cast(u8) cells[i].codepoint;
    text := cast(str) bytes_view(cast([*]const u8) &storage, cast(ssize) count);
    run := cached_shape(text, bold);
    if !run.changed return false;
    // The private glyph font has no Unicode fallback chain. Keep missing
    // characters on the ordinary per-cell path instead of drawing .notdef.
    for glyph: run.glyphs if glyph == 0 return false;
    font := &live.current.regular_glyphs;
    tried := &live.current.regular_glyphs_tried;
    face := live.current.regular_face.face;
    base := live.current.regular;
    if bold {
        font = &live.current.bold_glyphs;
        tried = &live.current.bold_glyphs_tried;
        face = live.current.bold_face.face;
        base = live.current.bold;
    }
    // The private cmap needs its own copy of the face. Ordinary text only uses
    // the Unicode handle, even with ligatures enabled.
    if !tried.* {
        tried.* = true;
        data: Font_Data;
        if native_face_data(face, &data) != 0 {
            defer native_free(&data);
            if live.current.family == "Segoe UI Emoji" include_vertical_ink(&data);
            font.* = Glyph_Font.create(&data, G.font_height(base), live.current.scale);
        }
    }
    if !G.font_valid(font.*) return false;
    first: s32;
    while first < count {
        selected := (cells[first].flags & 16#80000000) != 0;
        end := first + 1;
        while end < count && ((cells[end].flags & 16#80000000) != 0) == selected end += 1;
        fg := cells[first].fg;
        if (cells[first].flags & 4) != 0 fg = cells[first].bg;
        if selected                      fg = live.selected_fg;
        bounds: GN.Native_Rect = .{
            cast(f32)(x + first * cw),
            cast(f32) y,
            cast(f32)((end - first) * cw),
            cast(f32) ch
        };
        if clipped bounds = intersect(bounds, clip);
        shaped_ink(run, font.*, x, y, cw, ch, fg, bold, bounds);
        if (cells[first].flags & 2) != 0 {
            start := first;
            while start < end {
                underline := cells[start].underline_color;
                next := start + 1;
                while next < end && cells[next].underline_color == underline next += 1;
                emit(
                    .{
                        .kind = .Rectangle,
                        .x = x + start * cw,
                        .y = y + ch - 2,
                        .width = (next - start) * cw,
                        .height = 1,
                        .color = underline_ink(underline, fg),
                        .clipped = true,
                        .clip = bounds
                    }
                );
                start = next;
            }
        }
        first = end;
    }
    if cursor_column >= 0 && cursor_column < count {
        left := x + cursor_column * cw;
        bounds: GN.Native_Rect = .{ cast(f32) left, cast(f32) y, cast(f32) cw, cast(f32) ch };
        if clipped bounds = intersect(bounds, clip);
        emit(
            .{
                .kind = .Rectangle,
                .x = left,
                .y = y,
                .width = cw,
                .height = ch,
                .color = cursor_color,
                .clipped = true,
                .clip = bounds
            }
        );
        shaped_ink(run, font.*, x, y, cw, ch, live.cursor_ink, bold, bounds);
        if (cells[cursor_column].flags & 2) != 0
            emit(
                .{
                    .kind = .Rectangle,
                    .x = left,
                    .y = y + ch - 2,
                    .width = cw,
                    .height = 1,
                    .color = underline_ink(cells[cursor_column].underline_color, live.cursor_ink),
                    .clipped = true,
                    .clip = bounds
                }
            );
    }
    return true;
}

discard_unused_textures :: () -> bool {
    live := state();
    original := live.image_textures.count;
    i := live.image_textures.count;
    while i > 0 {
        i -= 1;
        if !live.image_textures[i].in_frame G.release_texture(live.image_textures.swap_remove(i).texture);
    }
    return live.image_textures.count != original;
}

image_texture :: (view: *Kitty.View) -> G.Texture {
    live := state();
    for i: 0..live.image_textures.count {
        if live.image_textures[i].token == view.token {
            live.image_textures[i].in_frame = true;
            return live.image_textures[i].texture;
        }
    }
    length := cast(ssize) view.width * cast(ssize) view.height * 4;
    // A placement may enlarge a single pixel cropped from the middle of an
    // image. Point sampling keeps neighboring pixels outside that crop.
    pixels := bytes_view(view.rgba, length);
    texture := G.create_texture(view.width, view.height, pixels, .Nearest);
    // Replacements and tab switches can exhaust Gui's texture slots while
    // unused textures from the preceding frame still reside in the cache.
    if !G.texture_valid(texture) && discard_unused_textures()
        texture = G.create_texture(view.width, view.height, pixels, .Nearest);
    if !G.texture_valid(texture) && Emoji_Render.release_textures()
        texture = G.create_texture(view.width, view.height, pixels, .Nearest);
    if G.texture_valid(texture) {
        live.image_textures.push(
            .{
                .token = view.token,
                .texture = texture,
                .in_frame = true,
                .context_id = live.current_context
            }
        );
    } else remember(G.last_error());
    return texture;
}

Image_Layers :: struct {
    first: ssize;
    above_background: ssize;
    above_text: ssize;
    end: ssize;
}

prepare_images :: (
    graphics: ?*Kitty.Store,
    view_offset: s32,
    x: s32,
    y: s32,
    cw: s32,
    ch: s32,
    viewport: GN.Native_Rect
) -> Image_Layers {
    live := state();
    first := live.image_commands.count;
    layers: Image_Layers = .{ first, first, first, first };
    #pattern ?store := graphics else {
        return layers;
    }
    for i: 0..Kitty.count(store) {
        view: Kitty.View;
        if !Kitty.view(store, cast(s32) i, cw, ch, view_offset, &view) continue;
        destination: GN.Native_Rect = .{
            cast(f32) x + cast(f32) view.dx,
            cast(f32) y + cast(f32) view.dy,
            cast(f32) view.dw,
            cast(f32) view.dh
        };
        bounds := intersect(destination, viewport);
        top := cast(f32) y + cast(f32) view.clip_top;
        bottom := cast(f32) y + cast(f32) view.clip_bottom;
        if bounds.y > top                     top = bounds.y;
        if bounds.y + bounds.height < bottom  bottom = bounds.y + bounds.height;
        if bounds.width <= 0 || bottom <= top continue;
        bounds.y = top;
        bounds.height = bottom - top;
        texture := image_texture(&view);
        if !G.texture_valid(texture) continue;
        live.image_commands.push(
            .{
                .texture = texture,
                .clip = bounds,
                .destination = destination,
                .source = .{
                    cast(f32) view.sx,
                    cast(f32) view.sy,
                    cast(f32) view.sw,
                    cast(f32) view.sh
                }
            }
        );
        // The store enumerates placements in ascending (z, image ID) order.
        if view.z < -1073741824 layers.above_background += 1;
        if view.z < 0           layers.above_text += 1;
        layers.end += 1;
    }
    return layers;
}

draw_images :: (first: ssize, end: ssize) {
    for i: first..end emit(.{ .kind = .Image, .image_index = i });
}

default_background :: (cell: Types.Render_Cell) -> bool {
    return (cell.flags & (4 | 16#80000000)) == 0 && (cell.flags & Terminal.CELL_DEFAULT_BG) != 0;
}

draw_grid :: (
    x: s32,
    y: s32,
    cols: s32,
    rows: s32,
    cw: s32,
    ch: s32,
    cells: [*]const Types.Render_Cell,
    cursor_x: s32,
    cursor_y: s32,
    visible: s32,
    cursor_color: u32,
    clipped: bool,
    clip: GN.Native_Rect,
    graphics: ?*Kitty.Store = null,
    view_offset: s32 = 0
) {
    live := state();
    if !live.active || cols <= 0 || cols > 512 || rows <= 0 || rows > 256 || cw <= 0 || ch <= 0 return;
    viewport: GN.Native_Rect = .{
        cast(f32) x,
        cast(f32) y,
        cast(f32)(cols * cw),
        cast(f32)(rows * ch)
    };
    if clipped viewport = intersect(viewport, clip);
    layers := prepare_images(graphics, view_offset, x, y, cw, ch, viewport);
    deep_images := layers.above_background > layers.first;
    // With deeply negative z, only cells with explicit backgrounds cover
    // the image. Paint default backgrounds first, then those placements.
    passes: s32 = 1;
    if deep_images passes = 2;
    for pass: 0..passes {
        for yi: 0..rows {
            row := cast(s32) yi;
            column: s32;
            while column < cols {
                c := cells[row * cols + column];
                span: s32 = 1;
                if (c.flags & 8) != 0 && column + 1 < cols span = 2;
                if !deep_images || default_background(c) == (pass == 0) {
                    draw_cell(
                        x + column * cw,
                        y + row * ch,
                        span * cw,
                        ch,
                        0,
                        c.fg,
                        c.bg,
                        c.flags & ~cast(u32) 2,
                        (c.flags & 16#80000000) != 0,
                        clipped,
                        clip
                    );
                }
                column += span;
            }
        }
        if deep_images && pass == 0 draw_images(layers.first, layers.above_background);
    }
    draw_images(layers.above_background, layers.above_text);
    shaped_cursor: bool;
    for yi: 0..rows {
        row := cast(s32) yi;
        column: s32;
        while column < cols {
            c := cells[row * cols + column];
            end := column + 1;
            if live.ligatures && shapeable(c) {
                while end < cols && shapeable(cells[row * cols + end]) && same_shape_style(
                    c,
                    cells[row * cols + end]
                ) end += 1;
                cursor_column: s32 = -1;
                if live.focused && visible != 0 && row == cursor_y && cursor_x >= column &&
                   cursor_x < end
                    cursor_column = cursor_x - column;
                if draw_shaped(
                    x + column * cw,
                    y + row * ch,
                    end - column,
                    cw,
                    ch,
                    cells + cast(ssize)(row * cols + column),
                    cursor_column,
                    cursor_color,
                    clipped,
                    clip
                ) {
                    if cursor_column >= 0 shaped_cursor = true;
                    column = end;
                    continue;
                }
            }
            // Unchanged glyphs use the exact legacy raster positions and fallback.
            while column < end {
                value := cells[row * cols + column];
                span: s32 = 1;
                if (value.flags & 8) != 0 && column + 1 < cols span = 2;
                draw_cell(
                    x + column * cw,
                    y + row * ch,
                    span * cw,
                    ch,
                    value.codepoint,
                    value.fg,
                    value.bg,
                    value.flags,
                    (value.flags & 16#80000000) != 0,
                    clipped,
                    clip,
                    false,
                    value.underline_color
                );
                column += span;
            }
        }
    }
    if visible != 0 && cursor_x >= 0 && cursor_x < cols && cursor_y >= 0 && cursor_y < rows {
        column := cursor_x;
        c := cells[cursor_y * cols + column];
        span: s32 = 1;
        if (c.flags & 16) != 0 && column > 0 && (cells[cursor_y * cols + column - 1].flags & 8) != 0 {
            column -= 1;
            c = cells[cursor_y * cols + column];
        }
        if (c.flags & 8) != 0 && column + 1 < cols span = 2;
        if live.focused {
            if !shaped_cursor
                draw_cell(
                    x + column * cw,
                    y + cursor_y * ch,
                    span * cw,
                    ch,
                    c.codepoint,
                    live.cursor_ink,
                    cursor_color,
                    c.flags & (3 | Terminal.CELL_EMOJI_STYLE | Terminal.CELL_TEXT_STYLE),
                    false,
                    clipped,
                    clip,
                    true,
                    c.underline_color
                );
        } else {
            left := x + column * cw;
            top := y + cursor_y * ch;
            emit(
                .{
                    .kind = .Rectangle,
                    .x = left,
                    .y = top,
                    .width = span * cw,
                    .height = 1,
                    .color = cursor_color,
                    .clipped = clipped,
                    .clip = clip
                }
            );
            emit(
                .{
                    .kind = .Rectangle,
                    .x = left,
                    .y = top + ch - 1,
                    .width = span * cw,
                    .height = 1,
                    .color = cursor_color,
                    .clipped = clipped,
                    .clip = clip
                }
            );
            emit(
                .{
                    .kind = .Rectangle,
                    .x = left,
                    .y = top,
                    .width = 1,
                    .height = ch,
                    .color = cursor_color,
                    .clipped = clipped,
                    .clip = clip
                }
            );
            emit(
                .{
                    .kind = .Rectangle,
                    .x = left + span * cw - 1,
                    .y = top,
                    .width = 1,
                    .height = ch,
                    .color = cursor_color,
                    .clipped = clipped,
                    .clip = clip
                }
            );
        }
    }
    draw_images(layers.above_text, layers.end);
}
fit_label :: (font: G.Font, text: str, width: s32) -> str {
    live := state();
    if G.measure_text(font, text) * live.current.scale <= cast(f32) width return text;
    ellipsis: str = "…";
    ensure_text_fonts(font, ellipsis);
    available := cast(f32) width / live.current.scale - G.measure_text(font, ellipsis);
    offset: ssize;
    used: f32;
    while offset < text.count {
        character := text.rune_at(offset).unwrap_or(#char "�");
        advance := G.glyph_advance(font, character);
        if used + advance > available break;
        used += advance;
        offset += 1;
        while offset < text.count && (text[offset] & 16#c0) == 16#80 offset += 1;
    }
    return tprint("{}{}", text[0..offset], ellipsis);
}

// Header labels reserve the ellipsis before finding a complete UTF-8 prefix.
// A tiny target that cannot hold even that marker stays empty, rather than
// showing a clipped dot or part of a multibyte glyph. Legacy labels keep their
// existing behavior through fit_label above.
fit_ui_label :: (text: str, width: s32) -> str {
    live := state();
    font := live.current.ui_small;
    if G.measure_text(font, text) * live.current.scale <= cast(f32) width return text;
    ellipsis: str = "…";
    ensure_text_fonts(font, ellipsis);
    available := cast(f32) width / live.current.scale - G.measure_text(font, ellipsis);
    if available < 0 return "";
    offset: ssize;
    used: f32;
    while offset < text.count {
        character := text.rune_at(offset).unwrap_or(#char "�");
        advance := G.glyph_advance(font, character);
        if used + advance > available break;
        used += advance;
        offset += 1;
        while offset < text.count && (text[offset] & 16#c0) == 16#80 offset += 1;
    }
    return tprint("{}{}", text[0..offset], ellipsis);
}
