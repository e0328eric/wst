//! Stage the Gui multi-window runtime and backport features for older SDKs.
#import "Glosso/Paths";
#import "File_System/Copy";
#import "File_System/Directory";
#import "File_System/File";
#import "File_System/Path";
#import "File_System/Temporary";
#import "Process/Run";
#import "Strings/Utf8";
#import "Format";
#import "Io";
#export "File_System/Temporary" {
    Temporary_Directory
};

// Prefer the same path across serial builds so the compiler can reuse its
// cache. Concurrent builds, or a previous interrupted build, get another slot.
create_stage :: (root: str) -> Temporary_Directory {
    for i: 0..ssize_max() {
        path := path_join(root, tprint("build/gui-sdk-{}", i));
        if create_directory(path) == {
        case .Ok;
            return .{ .path = path, .allocator = context.allocator, .valid = true };
        case .Err(error);
            if error.kind != .Already_Exists {
                print("wst build: cannot stage the Gui SDK: {}\n", error.kind);
                exit(1);
            }
        }
        path.free();
    }
    print("wst build: could not create a private SDK copy\n");
    exit(1);
}

contains_source :: (file: str, marker: str) -> bool {
    if read_file(path_join(GLOSSO_STANDARD_DIRECTORY, file)) == {
    case .Ok(source);
        defer source.free();
        return source.contains(marker);
    case .Err(error);
        print("wst build: cannot read {}: {}\n", file, error.kind);
        exit(1);
    }
}

apply_patch :: (stage: str, patch: str) -> bool {
    // Keep git apply rooted in our private tree even inside another checkout.
    if run_command(
        "git",
        tprint("--git-dir={}/.git", stage),
        tprint("--work-tree={}", stage),
        "apply",
        "--include=std/*",
        patch,
        .working_directory = stage,
        .capture_and_return_output = true,
        .no_window = true
    ) == {
    case .Ok(done);
        defer done.free();
        if done.status.exited && done.status.code == 0 return true;
        print("wst build: git apply failed for {}\n{}", patch, done.error_string);
        return false;
    case .Err(error);
        print("wst build: could not run git apply: {}\n", error.process.kind);
        if error.child.valid _ := error.child.close();
        return false;
    }
}

#public prepare :: (root: str, stage: *Temporary_Directory) -> str {
    original := GLOSSO_STANDARD_DIRECTORY;
    needs_memory := contains_source("Gui/native/renderer_api.h", "overlay_capacity(render.overlay_count+6)");
    needs_gpu := !contains_source("Gui/Input_Types.glo", "High_Performance_Gpu ::");
    needs_emoji := !contains_source("Unicode/utilities.glo", "is_unicode_emoji_presentation ::") ||
        !contains_source("Unicode/utilities.glo", "supports_unicode_emoji_variation ::");
    // Each cached glyph reserves one coverage run per bitmap pixel and keeps it.
    glyph_source := "Gui/native/font.c";
    needs_glyph_runs := contains_source(glyph_source, "g->runs=malloc(capacity*sizeof(*g->runs));") &&
        !contains_source(glyph_source, "realloc(g->runs,");
    needs_windows := !contains_source("Gui/Window.glo", "select_window ::");
    if !needs_memory && !needs_gpu && !needs_emoji && !needs_glyph_runs && !needs_windows return original;

    stage.* = create_stage(root);
    staged := path_join(stage.path, "std");
    if #pattern .Err(error) = copy_tree(original, staged, .flags = .Recursive | .Follow_Symlinks) {
        print("wst build: cannot copy the Gui SDK: {}\n", error.kind);
        stage.free();
        exit(1);
    }
    if needs_memory && !apply_patch(stage.path, path_join(root, "vendor/glosso/gui-memory.patch"))
        print("wst build: Gui memory backport unavailable; using the SDK's memory allocation.\n");
    if needs_glyph_runs && !apply_patch(stage.path, path_join(root, "vendor/glosso/gui-glyph-runs.patch"))
        print("wst build: Gui glyph memory backport unavailable; using the SDK's glyph cache.\n");
    if needs_gpu && !apply_patch(stage.path, path_join(root, "vendor/glosso/gui-gpu.patch")) {
        print("wst build: could not apply gui-gpu.patch; install Git or select a Gui SDK with High_Performance_Gpu.\n");
        stage.free();
        exit(1);
    }
    if needs_emoji && !apply_patch(stage.path, path_join(root, "vendor/glosso/unicode-emoji.patch")) {
        print("wst build: could not apply unicode-emoji.patch; select a Glosso SDK with Unicode emoji properties.\n");
        stage.free();
        exit(1);
    }
    if needs_windows && !apply_patch(stage.path, path_join(root, "vendor/glosso/gui-multi-window.patch")) {
        print("wst build: could not apply gui-multi-window.patch; install Git and select a compatible Glosso SDK.\n");
        stage.free();
        exit(1);
    }
    return staged;
}
