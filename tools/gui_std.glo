//! Backport Gui features to an isolated copy when the selected SDK needs them.
#import "Glosso/Paths";
#import "File_System/Copy";
#import "File_System/Directory";
#import "File_System/File";
#import "File_System/Path";
#import "File_System/Temporary";
#import "Process/Command";
#import "Strings/Utf8";
#import "Format";
#import "Io";
#export "File_System/Temporary" {
    Temporary_Directory
};

// Prefer the same path across serial builds so the compiler can reuse its
// cache. Concurrent builds, or a previous interrupted build, get another slot.
create_stage :: (root: str) -> Temporary_Directory {
    for i: 0..ssize_max() {
        path := path_join(root, tprint("build/gui-sdk-{}", i));
        if create_directory(path) == {
        case .Ok;
            return .{ .path = path, .allocator = context.allocator, .valid = true };
        case .Err(error);
            if error.kind != .Already_Exists {
                print("wst build: cannot stage the Gui SDK: {}\n", error.kind);
                exit(1);
            }
        }
        path.free();
    }
    print("wst build: could not create a private SDK copy\n");
    exit(1);
}

contains_source :: (file: str, marker: str) -> bool {
    if read_file(path_join(GLOSSO_STANDARD_DIRECTORY, file)) == {
    case .Ok(source);
        defer source.free();
        return source.contains(marker);
    case .Err(error);
        print("wst build: cannot read {}: {}\n", file, error.kind);
        exit(1);
    }
}

apply_patch :: (stage: str, patch: str) -> bool {
    // Keep git apply rooted in our private tree even inside another checkout.
    arguments := .[
        tprint("--git-dir={}/.git", stage),
        tprint("--work-tree={}", stage),
        "apply",
        "--exclude=tests/*",
        patch
    ];
    git := Command.command_make("git", arguments[..]);
    defer git.destroy();
    git.set_working_directory(stage);
    git.no_window = true;
    if git.run() == {
    case .Ok(done);
        return done.status.exited && done.status.code == 0;
    case .Err(error);
        if error.child.valid _ := error.child.close();
        return false;
    }
}

#public prepare :: (root: str, stage: *Temporary_Directory) -> str {
    original := GLOSSO_STANDARD_DIRECTORY;
    needs_memory := contains_source("Gui/native/renderer_api.h", "overlay_capacity(render.overlay_count+6)");
    needs_gpu := !contains_source("Gui/Input_Types.glo", "High_Performance_Gpu ::");
    if !needs_memory && !needs_gpu return original;

    stage.* = create_stage(root);
    staged := path_join(stage.path, "std");
    if #pattern .Err(error) = copy_tree(original, staged, .flags = .Recursive | .Follow_Symlinks) {
        print("wst build: cannot copy the Gui SDK: {}\n", error.kind);
        stage.free();
        exit(1);
    }
    if needs_memory && !apply_patch(stage.path, path_join(root, "vendor/glosso/gui-memory.patch"))
        print("wst build: Gui memory backport unavailable; using the SDK's memory allocation.\n");
    if needs_gpu && !apply_patch(stage.path, path_join(root, "vendor/glosso/gui-gpu.patch")) {
        print("wst build: could not apply gui-gpu.patch; install Git or select a Gui SDK with High_Performance_Gpu.\n");
        stage.free();
        exit(1);
    }
    return staged;
}
