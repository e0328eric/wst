#import "Compiler";
#import "Format";
#import "Io";
#import "Strings/Utf8";

test_bindings :: () -> str {
    if Native_Compile_Output.compile_c_archive(
        "st_win_pointer_test",
        .["tests/pointer_native_helper.c"],
        .compiler_args = .["-Wall", "-Wextra", "-Werror"]
    ) == {
    case .Ok(built);
        return tprint("helper :: #library,static \"{}\";", built.artifact.replace("\\", "/"));
    case .Err(error);
        print("pointer test helper build failed: {}\n", error.message);
        return "#comptime { #compile_error \"pointer test helper build failed\"; }";
    }
}
#insert #comptime test_bindings();
#public {

save_cursor :: () #foreign helper "pointer_test_save_cursor";
restore_cursor :: () #foreign helper "pointer_test_restore_cursor";
message :: (window: usize, kind: s32, x: s32, y: s32, buttons: s32) -> s32 #foreign helper "pointer_test_message";
captured :: (window: usize) -> s32 #foreign helper "pointer_test_capture";
current_cursor :: () -> s32 #foreign helper "pointer_test_current_cursor";

}
