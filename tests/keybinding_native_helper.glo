#import "Compiler";
#import "Format";
#import "Io";
#import "Strings/Utf8";

test_bindings :: () -> str {
    if Native_Compile_Output.compile_c_archive(
        "st_win_keybinding_test",
        .["tests/keybinding_native_helper.c"],
        .compiler_args = .["-Wall", "-Wextra", "-Werror"]
    ) == {
    case .Ok(built);
        return tprint("helper :: #library,static \"{}\";", built.artifact.replace("\\", "/"));
    case .Err(error);
        print("keybinding test helper build failed: {}\n", error.message);
        return "#comptime { #compile_error \"keybinding test helper build failed\"; }";
    }
}
#insert #comptime test_bindings();
#public {

test_window :: () -> usize #foreign helper "kb_test_window";
post_key :: (window: usize, key: s32, mods: s32) -> s32 #foreign helper "kb_test_post_key";

}
