G :: #import "Gui";
R :: #import "../src/gui_render.glo";
P :: #import "../src/platform_types.glo";
T :: #import "../src/terminal.glo";
#import "Io";
#import "Strings/Utf8";
#import "File_System/File";

check :: (ok: bool, message: str) {
    if !ok {
        print("FAIL: {}\n", message);
        exit(1);
    }
}
little32 :: (bytes: str, at: ssize) -> u32 {
    return cast(u32) bytes[at] | (cast(u32) bytes[at + 1] << 8) | (cast(u32) bytes[at + 2] << 16) | (
        cast(u32) bytes[at + 3] << 24
    );
}
ink_count :: (bitmap: str, x: s32, y: s32, width: s32, height: s32, background: u32) -> ssize {
    stride := cast(ssize) little32(bitmap, 18) * 4;
    offset := cast(ssize) little32(bitmap, 10);
    count: ssize;
    for row: 0..height for column: 0..width {
        at := offset + (cast(ssize) y + row) * stride + (cast(ssize) x + column) * 4;
        if (little32(bitmap, at) & 16#ffffff) != background count += 1;
    }
    return count;
}
pixel :: (bitmap: str, x: s32, y: s32) -> u32 {
    stride := cast(ssize) little32(bitmap, 18) * 4;
    offset := cast(ssize) little32(bitmap, 10);
    return little32(bitmap, offset + cast(ssize) y * stride + cast(ssize) x * 4) & 16#ffffff;
}

// Grayscale text and antialiasing on a gray prompt background cannot create
// any saturated pixels. Check both sides to catch a clipped two-column glyph.
has_color :: (bitmap: str, x: s32, y: s32, width: s32, height: s32) -> bool {
    for row: y..y + height for column: x..x + width {
        rgb := pixel(bitmap, column, row);
        r := cast(s32)(rgb >> 16);
        g := cast(s32)((rgb >> 8) & 255);
        b := cast(s32)(rgb & 255);
        if (r - g).abs() > 40 || (g - b).abs() > 40 || (r - b).abs() > 40 return true;
    }
    return false;
}

PROMPT_X: s32 :: 16;
PROMPT_Y: s32 :: 160;
PROMPT_BG: u32 :: 16#303030;
SELECTED_BG: u32 :: 16#909090;
SEPARATOR_FG: u32 :: 16#cc4573;
HEART_X: s32 :: 450;
CURSOR_BG: u32 :: 16#707070;

draw_prompt :: (cw: s32, ch: s32) {
    R.set_colors(16#ffffff, SELECTED_BG, 0);
    cells: [7]P.Render_Cell = .[
        .{ 16#23f0, 16#ffffff, PROMPT_BG, 8 },
        .{ 0, 0, PROMPT_BG, 16 },
        .{ 16#1f3e0, 16#ffffff, PROMPT_BG, 8 | 16#80000000 },
        .{ 0, 0, PROMPT_BG, 16 | 16#80000000 },
        .{ 49, 16#ffffff, PROMPT_BG, 0 },
        .{ 16#e0b0, SEPARATOR_FG, PROMPT_BG, 0 },
        .{ 16#e0b2, SEPARATOR_FG, PROMPT_BG, 0 }
    ];
    source := cast([*]const P.Render_Cell) &cells;
    R.grid(PROMPT_X, PROMPT_Y, 7, 1, cw, ch, source, 0, 0, 0, 0);
    R.grid_clipped(300, PROMPT_Y, 7, 1, cw, ch, source, 0, 0, 0, 0, cw, ch);
    hearts: [3]P.Render_Cell = .[
        .{ 16#2764, 16#ffffff, PROMPT_BG, 0 },
        .{ 16#2764, 16#ffffff, PROMPT_BG, 8 | T.CELL_EMOJI_STYLE },
        .{ 0, 0, PROMPT_BG, 16 }
    ];
    R.set_focus(true);
    source = cast([*]const P.Render_Cell) &hearts;
    R.grid(HEART_X, PROMPT_Y, 3, 1, cw, ch, source, 2, 0, 1, CURSOR_BG);
}

check_prompt :: (bitmap: str, cw: s32, ch: s32) {
    text_ink := ink_count(bitmap, HEART_X, PROMPT_Y, cw, ch, PROMPT_BG);
    check(
        text_ink > 0 && !has_color(bitmap, HEART_X, PROMPT_Y, cw, ch),
        "a heart without VS16 uses the terminal foreground"
    );
    cursor_left := pixel(bitmap, HEART_X + cw, PROMPT_Y);
    cursor_right := pixel(bitmap, HEART_X + 3 * cw - 1, PROMPT_Y);
    check(
        cursor_left == CURSOR_BG && cursor_right == CURSOR_BG,
        "the cursor spans both heart cells"
    );
    check(
        has_color(bitmap, HEART_X + cw, PROMPT_Y, 2 * cw, ch),
        "a VS16 heart retains its color with a focused cursor on its trailing column"
    );
    for column: cast(s32) 0..4 check(
        has_color(bitmap, PROMPT_X + column * cw, PROMPT_Y, cw, ch),
        "normal clock and selected house retain their colors across both columns"
    );
    check(
        pixel(bitmap, PROMPT_X + 2 * cw, PROMPT_Y) == SELECTED_BG,
        "the selection background shows through the transparent emoji corners"
    );
    check(
        ink_count(bitmap, PROMPT_X + 4 * cw, PROMPT_Y, cw, ch, PROMPT_BG) > 0,
        "the digit following both wide emoji is visible in its own cell"
    );
    outside_ink := ink_count(bitmap, 300 + cw, PROMPT_Y, cw, ch, 16#112233);
    check(has_color(bitmap, 300, PROMPT_Y, cw, ch), "the clipped pane retains the visible half");
    check(outside_ink == 0, "a half-visible emoji stays inside the pane");
    right := PROMPT_X + 5 * cw;
    left := right + cw;
    for dy: cast(s32) 0..ch {
        y := PROMPT_Y + dy;
        check(
            pixel(bitmap, right, y) != PROMPT_BG && pixel(bitmap, left + cw - 1, y) != PROMPT_BG,
            "both Powerline separators fill the cell height in their respective directions"
        );
    }
    middle := PROMPT_Y + ch / 2;
    check(
        pixel(bitmap, right + cw - 1, PROMPT_Y) == PROMPT_BG && pixel(bitmap, left, PROMPT_Y) == PROMPT_BG,
        "the corners beside the tips show the adjacent background"
    );
    check(
        pixel(bitmap, right + cw - 3, middle) == SEPARATOR_FG && pixel(bitmap, left + 2, middle) == SEPARATOR_FG,
        "both Powerline tips reach across their cell at the center"
    );
}

main :: () {
    window := G.create_window(700, 400, "wst Gui renderer test", .Hidden | .High_Dpi);
    check(G.window_valid(window), "create standard Gui window");
    defer G.destroy_window(window);
    R.bind_window(window);
    defer R.close();
    prepared: R.Prepared;
    check(R.prepare("Consolas", 16, G.content_scale(window), &prepared), R.error_message());
    check(prepared.cw > 0 && prepared.ch > 0, "installed font metrics");
    for chain: prepared.fallback check(chain.attempted == 0, "unused fallback fonts stay unloaded");
    check(
        !G.font_valid(prepared.regular_glyphs) && !G.font_valid(prepared.bold_glyphs),
        "private cmap faces stay unloaded before a ligature is drawn"
    );
    R.commit(&prepared);
    check(G.update_window_events(window), "pump Gui input");
    check(R.frame_begin(16#112233), "begin Gui render");
    cw, ch: s32;
    R.metrics(&cw, &ch);
    cells: [6]P.Render_Cell = .[
        .{ 65, 16#ffffff, 16#112233, 0 },
        .{ 16#d55c, 16#ffff00, 16#203040, 8 },
        .{ 0, 0, 0, 16 },
        .{ 16#1f600, 16#ff00ff, 16#112233, 8 },
        .{ 0, 0, 0, 16 },
        .{ 90, 16#ffffff, 16#112233, 0 }
    ];
    R.grid(12, 50, 6, 1, cw, ch, cast([*]const P.Render_Cell) &cells, 0, 0, 1, 16#e5c07b);
    R.draw_label(12, 5, 650, 36, "Standard Gui / 한글 / 日本語 / emoji 😀", 16#ffffff);
    // The taller reference reveals ink clipped by a standard cell.
    R.cell(200, 100, 2 * cw, ch, 16#1f600, 16#ffffff, 16#203040, 8, 0);
    R.cell(400, 100 - ch, 2 * cw, 3 * ch, 16#1f600, 16#ffffff, 16#203040, 8, 0);
    draw_prompt(cw, ch);
    // Chrome primitives share the frame/replay lifetime with terminal text.
    R.rounded_rect(20, 240, 160, 60, 14, 16#304050);
    R.line(35, 260, 50, 275, 2.0, 16#79dac8);
    R.line(35, 275, 50, 260, 2.0, 16#79dac8);
    R.draw_ui_label(65, 240, 100, 60, "wst / 한글", 16#b2ceee);
    ui_width := R.measure_ui("Windows terminal");
    check(ui_width > 0 && R.measure_ui("") == 0, "proportional chrome text reports physical width");
    bounded_width := R.measure_ui("A한…");
    R.draw_ui_label(220, 240, bounded_width, 60, "A한국어 terminal profile", 16#b2ceee);
    R.draw_ui_label(420, 240, bounded_width, 60, "A한…", 16#b2ceee);
    R.draw_ui_label(620, 240, 1, 60, "한국어 profile", 16#b2ceee);
    check(R.snapshot("build/gui_renderer_active.bmp") != 0, R.error_message());
    R.frame_end();
    check(G.update_window_events(window), "pump snapshot replay input");
    check(R.snapshot("build/gui_renderer_replayed.bmp") != 0, R.error_message());
    first, second: str;
    if read_file("build/gui_renderer_active.bmp", 32 * 1024 * 1024) == {
    case .Ok(data);
        first = data;
    case .Err;
        exit(1);
    }
    defer first.free();
    if read_file("build/gui_renderer_replayed.bmp", 32 * 1024 * 1024) == {
    case .Ok(data);
        second = data;
    case .Err;
        exit(1);
    }
    defer second.free();
    check(first == second, "post-present snapshot replays the exact Gui composition");
    check(first.count > 54 && first[0] == 66 && first[1] == 77, "legacy snapshot is a bitmap");
    check_prompt(first, cw, ch);
    check(
        pixel(first, 20, 240) == 16#112233 && pixel(first, 25, 265) == 16#304050,
        "rounded corners preserve the backdrop and fill their interior"
    );
    check(
        ink_count(first, 33, 258, 20, 20, 16#304050) > 0,
        "vector icon strokes produce image pixels"
    );
    for y: cast(s32) 240..300 for x: cast(s32) 0..bounded_width {
        check(
            pixel(first, 220 + x, y) == pixel(first, 420 + x, y),
            "bounded UTF-8 chrome text renders its complete prefix and ellipsis"
        );
    }
    check(
        ink_count(first, 620, 240, 1, 60, 16#112233) == 0,
        "a target narrower than the ellipsis remains empty"
    );
    clipped_ink := ink_count(first, 200, 100, 2 * cw, ch, 16#203040);
    reference_ink := ink_count(first, 400, 100 - ch, 2 * cw, 3 * ch, 16#203040);
    check(
        reference_ink > 0 && clipped_ink == reference_ink,
        "emoji ascenders and descenders fit inside a terminal row"
    );
    check(
        R.prepare("D2KodingLigature Nerd Font Mono", 20, G.content_scale(window), &prepared),
        R.error_message()
    );
    R.discard(&prepared);
    check(R.prepare("Consolas", 32, G.content_scale(window), &prepared), R.error_message());
    R.commit(&prepared);
    check(
        R.measure_ui("Windows terminal") == ui_width,
        "terminal zoom keeps chrome text at thirteen logical pixels"
    );
    check(!R.prepare("", 16, 1, &prepared), "reject invalid family");
    print(
        "Gui renderer tests passed: installed fonts, Unicode fallback, composition and snapshot replay.\n"
    );
}
