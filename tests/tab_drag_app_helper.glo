#import "Compiler";
#import "Format";
#import "Io";
#import "Strings/Utf8";

test_bindings :: () -> str {
    if Native_Compile_Output.compile_c_archive(
        "wst_tab_drag_app_test",
        .["tests/tab_drag_app_helper.c"],
        .compiler_args = .["-Wall", "-Wextra", "-Werror"]
    ) == {
    case .Ok(built);
        return tprint("helper :: #library,static \"{}\";", built.artifact.replace("\\", "/"));
    case .Err(error);
        print("tab drag application test helper build failed: {}\n", error.message);
        return "#comptime { #compile_error \"tab drag application test helper build failed\"; }";
    }
}
#insert #comptime test_bindings();
#comptime {
    add_current_linker_arg("user32.lib");
    add_current_linker_arg("kernel32.lib");
    add_current_linker_arg("gdi32.lib");
}

#public Tab_Point :: #fn_ptr(width: s32, dpi: s32, count: s32, index: s32, x: *s32, y: *s32) -> s32 #c_call;
#public run :: (tab_point: Tab_Point) -> s32 #foreign helper "wst_tab_drag_app_test";
