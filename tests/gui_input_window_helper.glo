#import "Compiler";
#import "Format";
#import "Strings/Utf8";
#import "Io";
source :: () -> str {
    if Native_Compile_Output.compile_c_archive(
        "wst_gui_input_test",
        .["tests/gui_input_window_helper.c"],
        .compiler_args = .["-Wall", "-Wextra", "-Werror"]
    ) == {
    case .Ok(built);
        return tprint("native :: #library,static \"{}\";", built.artifact.replace("\\", "/"));
    case .Err(error);
        print("Gui input test helper build failed: {}\n", error.message);
        return "#comptime { #compile_error \"Gui input helper build failed\"; }";
    }
}
#insert #comptime source();
#public {

key :: (window: usize, key: s32, mods: s32) -> s32 #foreign native "gui_input_test_key";
unicode :: (window: usize, cp: u32) -> s32 #foreign native "gui_input_test_unicode";
pointer :: (window: usize, kind: s32, x: s32, y: s32) -> s32 #foreign native "gui_input_test_pointer";

}
