//! Verify that a native VT client can query Kitty graphics through the actual ConPTY pipes.
P :: #import "../src/windows_pty.glo";
T :: #import "../src/terminal.glo";
K :: #import "../src/kitty_store.glo";
Process :: #import "Process";
#import "Process/Command";
#import "File_System/Temporary";
#import "File_System/Path";
#import "File_System/Copy";
#import "Io";
#import "Format";
#import "Strings/Utf8";
kernel32 :: #library,system "kernel32";
GetStdHandle :: (which: s32) -> usize #foreign kernel32;
GetConsoleMode :: (handle: usize, mode: *u32) -> s32 #foreign kernel32;
GetModuleHandleA :: (name: cstr) -> usize #foreign kernel32;
SetConsoleMode :: (handle: usize, mode: u32) -> s32 #foreign kernel32;
ReadFile :: (handle: usize, bytes: [*]u8, capacity: u32, count: *u32, overlapped: usize) -> s32 #foreign kernel32;
WriteFile :: (handle: usize, bytes: [*]const u8, size: u32, count: *u32, overlapped: usize) -> s32 #foreign kernel32;

commands :: "\x1b[14t\x1b[16t\x1b_Ga=q,i=42,f=24,s=1,v=1;AQID\x1b\\\x1b_Ga=T,i=43,f=24,s=1,v=1,C=1;BwgJ\x1b\\";
expected :: "\x1b[4;384;640t\x1b[6;16;8t\x1b_Gi=42;OK\x1b\\\x1b_Gi=43;OK\x1b\\";

client :: () {
    input := GetStdHandle(-10);
    output := GetStdHandle(-11);
    mode: u32;
    if GetConsoleMode(output, &mode) == 0 || SetConsoleMode(output, mode | 5) == 0 ||
       SetConsoleMode(input, 16#200) == 0
        exit(2);
    count: u32;
    if WriteFile(output, commands.data, cast(u32) commands.count, &count, 0) == 0 ||
       count != cast(u32) commands.count
        exit(3);
    received: [128]u8;
    total: ssize;
    while total < expected.count {
        if ReadFile(input, cast([*]u8) &received[total], cast(u32)(128 - total), &count, 0) == 0 ||
           count == 0
            exit(4);
        total += cast(ssize) count;
    }
    if cast(str) received[..total] != expected exit(5);
}

// Exercise a portable install even when a developer has old sidecars in build/.
run_standalone :: () -> bool {
    source := Process.current_executable_path();
    defer source.free();
    #pattern .Ok(directory) := Temporary_Directory.create_temporary_directory(
        path_dirname(source),
        "kitty-standalone-"
    ) else {
        return false;
    }
    defer directory.free();
    executable := path_join(directory.path, "transport.exe");
    defer executable.free();
    if copy_file(source, executable).is_err() return false;
    command := Command.command_make(executable, .["--standalone"]);
    defer command.destroy();
    command.set_working_directory(directory.path);
    command.no_window = true;
    command.manage_tree = true;
    if command.run() == {
    case .Ok(done);
        return done.status.exited && done.status.code == 0;
    case .Err(error);
        if error.child.valid {
            _ := error.child.kill();
            _ := error.child.wait();
            _ := error.child.close();
        }
        return false;
    }
}

main :: () {
    args := get_cmdline_args();
    if args.count > 1 && args[1] == "--client" {
        client();
        return;
    }
    if args.count == 1 {
        #assert run_standalone(), "Kitty transport works with only the executable installed";
        print(
            "Standalone ConPTY loaded the bundled host and received the Kitty graphics replies.\n"
        );
        return;
    }
    terminal: T.Terminal;
    T.init(&terminal, 80, 24, 10, 16#ffffff, 0);
    defer T.release(&terminal);
    T.set_cell_size(&terminal, 8, 16);
    if P.pty_start(tprint("\"{}\" --client", args[0]).c_string(), 80, 24) == 0 {
        print("Could not start graphics test client: {}\n", P.error().to_string());
        exit(1);
    }
    defer P.close_sessions();
    #assert GetModuleHandleA("conpty.dll") != 0, "standalone terminal loads the bundled ConPTY DLL";
    buffer: [4096]u8;
    start := P.ticks();
    while P.ticks() - start < 5000 {
        n := P.pty_read(cast([*]u8) &buffer, 4096);
        if n > 0 T.feed(&terminal, cast(str) buffer[..cast(ssize) n]);
        if terminal.replies.count > 0 {
            response := terminal.replies.view();
            #assert P.pty_send(response.data, cast(s32) response.count) != 0;
            terminal.replies.clear();
        }
        code: s32;
        if P.pty_status(&code) == 1 {
            #assert code == 0, "ConPTY client received the cell metrics and graphics replies";
            #assert K.count(&terminal.graphics) == 1, "only the transmitted image is displayed";
            v: K.View;
            #assert K.view(&terminal.graphics, 0, 8, 16, 0, &v);
            #assert v.width == 1 && v.height == 1 && v.rgba[0] == 7 && v.rgba[1] == 8 &&
                v.rgba[2] == 9 && v.rgba[3] == 255;
            print(
                "ConPTY client queried pixel dimensions, displayed a Kitty image and received its acknowledgments.\n"
            );
            return;
        }
        P.wait(10);
    }
    print("Timed out waiting for Kitty graphics replies from the ConPTY client.\n");
    exit(1);
}
