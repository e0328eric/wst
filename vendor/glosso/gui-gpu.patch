 #include <math.h>
 #include <stddef.h>
 #include <stdlib.h>
@@ -252,25 +253,62 @@
     return overlay_buffer_create();
 }
 
+static HRESULT create_device(IDXGIAdapter *adapter, D3D_DRIVER_TYPE type, const DXGI_SWAP_CHAIN_DESC *description) {
+    D3D_FEATURE_LEVEL level = D3D_FEATURE_LEVEL_11_0;
+    HRESULT status = D3D11CreateDeviceAndSwapChain(adapter, type, NULL, 0, &level, 1, D3D11_SDK_VERSION,
+        description, &render.presentation, &render.device, NULL, &render.commands);
+    if (FAILED(status)) {
+        RESET_COM(render.commands);
+        RESET_COM(render.device);
+        RESET_COM(render.presentation);
+    }
+    return status;
+}
+
+static HRESULT create_hardware_device(const DXGI_SWAP_CHAIN_DESC *description, uint32_t flags) {
+    IDXGIFactory6 *factory = NULL;
+    if (SUCCEEDED(CreateDXGIFactory1(&IID_IDXGIFactory6, (void **)&factory))) {
+        DXGI_GPU_PREFERENCE preference = (flags & GUI_HIGH_PERFORMANCE_GPU)
+            ? DXGI_GPU_PREFERENCE_HIGH_PERFORMANCE : DXGI_GPU_PREFERENCE_MINIMUM_POWER;
+        for (UINT index = 0; ; ++index) {
+            IDXGIAdapter1 *adapter = NULL;
+            HRESULT status = IDXGIFactory6_EnumAdapterByGpuPreference(factory, index, preference,
+                &IID_IDXGIAdapter1, (void **)&adapter);
+            if (FAILED(status)) break;
+            DXGI_ADAPTER_DESC1 info;
+            status = IDXGIAdapter1_GetDesc1(adapter, &info);
+            if (SUCCEEDED(status) && !(info.Flags & DXGI_ADAPTER_FLAG_SOFTWARE)) {
+                status = create_device((IDXGIAdapter *)adapter, D3D_DRIVER_TYPE_UNKNOWN, description);
+                if (SUCCEEDED(status)) {
+                    IDXGIAdapter1_Release(adapter);
+                    IDXGIFactory6_Release(factory);
+                    return status;
+                }
+            }
+            IDXGIAdapter1_Release(adapter);
+        }
+        IDXGIFactory6_Release(factory);
+    }
+    /* Older DXGI versions and drivers may only support the default adapter. */
+    return create_device(NULL, D3D_DRIVER_TYPE_HARDWARE, description);
+}
