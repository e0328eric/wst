     if(!platform_open(width,height,title,bytes,flags)) return false;
     platform_size(&render.width,&render.height);render.flags=flags;
     DXGI_SWAP_CHAIN_DESC description={0};description.BufferDesc.Width=render.width;description.BufferDesc.Height=render.height;
     description.BufferDesc.Format=DXGI_FORMAT_R8G8B8A8_UNORM;description.SampleDesc.Count=1;
     description.BufferUsage=DXGI_USAGE_RENDER_TARGET_OUTPUT;description.BufferCount=2;description.OutputWindow=platform_window();
     description.Windowed=TRUE;description.SwapEffect=DXGI_SWAP_EFFECT_FLIP_DISCARD;
-    D3D_FEATURE_LEVEL level=D3D_FEATURE_LEVEL_11_0,chosen;
-    HRESULT status=D3D11CreateDeviceAndSwapChain(NULL,D3D_DRIVER_TYPE_HARDWARE,NULL,0,&level,1,D3D11_SDK_VERSION,
-        &description,&render.presentation,&render.device,&chosen,&render.commands);
+    HRESULT status=create_hardware_device(&description,flags);
     bool software=false;
     if(FAILED(status)) {
-        RESET_COM(render.commands);RESET_COM(render.device);RESET_COM(render.presentation);
-        status=D3D11CreateDeviceAndSwapChain(NULL,D3D_DRIVER_TYPE_WARP,NULL,0,&level,1,D3D11_SDK_VERSION,
-            &description,&render.presentation,&render.device,&chosen,&render.commands);software=SUCCEEDED(status);
+        status=create_device(NULL,D3D_DRIVER_TYPE_WARP,&description);
+        software=SUCCEEDED(status);
     }
     if(!hr_ok(status,"Initialize Direct3D 11") || !window_targets_create() || !pipeline_create()) {gui_close();return false;}
     IDXGIFactory *factory=NULL;
