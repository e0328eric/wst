+/* Win32 may dispatch a message to any window during polling, resizing or
+   activation. Select its input state only for the duration of that call. */
+static LRESULT CALLBACK dispatch_window(HWND window, UINT message, WPARAM value, LPARAM detail) {
+    GuiPlatform *state;
+    if (message == WM_NCCREATE) {
+        const CREATESTRUCTW *creation = (const CREATESTRUCTW *)detail;
+        state = creation->lpCreateParams;
+        if (!state) return FALSE;
+        SetLastError(0);
+        if (!SetWindowLongPtrW(window, GWLP_USERDATA, (LONG_PTR)state) && GetLastError())
+            return FALSE;
+        state->window = window;
+    } else {
+        state = (GuiPlatform *)GetWindowLongPtrW(window, GWLP_USERDATA);
+        if (!state) return DefWindowProcW(window, message, value, detail);
+    }
+
+    GuiPlatform *previous = selected_platform;
+    selected_platform = state;
+    LRESULT result = dispatch_window_message(window, message, value, detail);
+    if (message == WM_NCDESTROY) {
+        SetWindowLongPtrW(window, GWLP_USERDATA, 0);
+        state->window = NULL;
+    }
+    selected_platform = previous;
+    return result;
+}
+
+static bool acquire_window_class(HINSTANCE instance) {
+    if (!window_class_users) {
+        previous_dpi = SetThreadDpiAwarenessContext(DPI_AWARENESS_CONTEXT_PER_MONITOR_AWARE_V2);
+        WNDCLASSEXW descriptor = {0};
+        descriptor.cbSize = sizeof(descriptor);
+        descriptor.lpfnWndProc = dispatch_window;
+        descriptor.hInstance = instance;
+        descriptor.hCursor = LoadCursorW(NULL, MAKEINTRESOURCEW(32512));
+        descriptor.lpszClassName = window_class_name;
+        window_class = RegisterClassExW(&descriptor);
+        if (!window_class) {
+            report_windows_error("Could not register the Gui window class");
+            if (previous_dpi) SetThreadDpiAwarenessContext(previous_dpi);
+            previous_dpi = NULL;
+            return false;
+        }
+        quit_requested = false;
+    }
+    ++window_class_users;
+    return true;
+}
+
+static void release_window_class(HINSTANCE instance) {
+    if (--window_class_users) return;
+    UnregisterClassW(window_class_name, instance);
+    window_class = 0;
+    if (previous_dpi) SetThreadDpiAwarenessContext(previous_dpi);
+    previous_dpi = NULL;
+}
